#!/bin/bash
# Unraid event hook: the Docker service has just started.
#
# emhttpd fires this on array start AND on an array stop->start (or a Docker
# service restart from Settings > Docker) WITHOUT a full reboot — the cases the
# plugin's boot path (rc.local re-running the .plg) never covers.
#
# Why we need it: Unraid's shutdown runs `rc.docker stop`, which EXPLICITLY stops
# our runner containers. Docker's `--restart=unless-stopped` policy deliberately
# does not resurrect explicitly-stopped containers when the daemon returns, so
# the fleet would otherwise stay down until the next reboot. boot-autostart waits
# for dockerd + the cache pool to be ready, recreates stopped runners with fresh
# registration credentials, refills the fleet to its floor, and performs a delayed
# recovery sweep for any running container stalled at protected credential handoff.
# Transient partial starts retry, and a dedicated lock coalesces this hook with
# the plugin-install boot hook. It is idempotent and a no-op until GitHub
# credentials are configured.
#
# Detached so we never block Unraid's start sequence.
PLGDIR="/usr/local/emhttp/plugins/ci-runner-farm"
RUNDIR="/var/local/emhttp/ci-runner-farm"
mkdir -p "$RUNDIR"
( nohup "$PLGDIR/include/runner-farm.sh" boot-autostart >>"$RUNDIR/boot.log" 2>&1 & ) || true

# The optional distributed node is installed on the cache pool, never flash.
# Its container adapter requires Docker, so start it only after docker_started.
DISTRIBUTED_NODE_SERVICE="/mnt/cache/appdata/ci-runner-farm/distributed-node/service.sh"
if [ -x "$DISTRIBUTED_NODE_SERVICE" ]; then
  ( nohup "$DISTRIBUTED_NODE_SERVICE" start >>"$RUNDIR/distributed-node-boot.log" 2>&1 & ) || true
fi
