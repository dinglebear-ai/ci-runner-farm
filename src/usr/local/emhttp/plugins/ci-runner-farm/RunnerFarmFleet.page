function crfDemandValue(pool,key){
  const value=Number(pool&&pool[key]);
  return pool&&pool.demand_fresh===true&&Number.isFinite(value)&&value>=0?String(value):'—';
}
function crfAssignedDemand(d){
  const pools=Array.isArray(d&&d.pools)?d.pools:[];
  if(!pools.every(p=>p&&p.demand_fresh===true&&Number.isFinite(Number(p.assigned_jobs))&&Number(p.assigned_jobs)>=0))return null;
  return pools.reduce((n,p)=>n+Number(p.assigned_jobs),0);
}

function crfBackendAction(action){
  if(CRF_BACKEND_PENDING)return;
  const d=window.CRF_LAST||{}, b=d.backend||{}, c=d.compatibility||{};
  const assigned=crfAssignedDemand(d);
  const busy=(d.runners||[]).filter(r=>r.state==='running'&&r.phase==='busy').length;
  const idle=(d.runners||[]).filter(r=>r.state==='running'&&r.phase==='idle').length;
  const payload={action,expected_config_revision:d.config_revision,
    expected_ownership_revision:b.ownership_revision,
    expected_compatibility_record_id:c.record_id,
    expected_transition_revision:b.transition_revision};
  const run=()=>{
    CRF_BACKEND_PENDING=true;crfRefresh();
    crfPost(payload).then(o=>{crfLog(o);crfToast(o.ok?(action==='begin-migration'?'Migration advanced':'Rollback advanced'):('Backend operation failed'+(o.log?': '+o.log:'')));})
      .catch(e=>{crfToast('Backend operation failed');console.error(e);})
      .finally(()=>{CRF_BACKEND_PENDING=false;crfRefresh();});
  };
  const consequence=action==='begin-migration'?'Classic remains effective until its remote eligibility barrier is proven.':'Scale sets become ineligible first; assigned JIT work drains before classic is reactivated.';
  const text='Busy '+busy+' · idle '+idle+' · assigned '+(assigned===null?'—':assigned)+'\nConfig '+String(d.config_revision||'').slice(0,12)+' · transition '+String(b.transition_revision||'').slice(0,12)+'\n\n'+consequence;
  if(window.swal)swal({title:action==='begin-migration'?'Begin fleet migration?':'Roll back to classic?',text,type:'warning',showCancelButton:true,confirmButtonText:action==='begin-migration'?'Begin migration':'Begin rollback'},ok=>{if(ok)run();});
  else if(window.confirm(text))run();
}

function crfElapsed(iso){
  const t=Date.parse(iso); if(isNaN(t)) return null;
  const m=Math.floor((Date.now()-t)/60000);
  return {m, txt: m<1?'<1m': m<60? m+'m' : Math.floor(m/60)+'h'+String(m%60).padStart(2,'0')};
}
function crfUptime(iso){
  const t=Date.parse(iso||''); if(isNaN(t)) return '';
  const minutes=Math.max(0,Math.floor((Date.now()-t)/60000));
  if(minutes<1)return '<1m';
  if(minutes<60)return minutes+'m';
  const hours=Math.floor(minutes/60);
  return hours<24?hours+'h':Math.floor(hours/24)+'d '+(hours%24)+'h';
}
function crfBar(pct){
  const p=Math.max(0,Math.min(100,Math.round(pct)));
  const cls=p>90?' crf-hot':p>60?' crf-mid':'';
  return '<span class="crf-ubar'+cls+'"><span style="width:'+p+'%"></span></span>';
}
/* The per-poll VOLATILE cells — the elapsed timer and the CPU/mem bars, which tick
   every 5s for a busy runner. Factored out so the full row builder and crfRefresh's
   in-place fast-path render them identically from ONE source of truth (no drift). */
function crfVolatile(r){
  const running=r.state==='running';
  let elapsedHtml='';
  if(running&&r.phase==='busy'&&r.job_started){
    const e=crfElapsed(r.job_started);
    if(e) elapsedHtml=' <span class="crf-elapsed'+(e.m>=120?' crf-el-hot':e.m>=30?' crf-el-warn':'')+'" title="running for '+e.txt+'">'+e.txt+'</span>';
  }
  const cpuKnown=running&&r.cpu_pct>=0, memKnown=running&&r.mem_used_mib>=0&&r.mem_gb;
  const cpuPct=cpuKnown?r.cpu_pct:0;
  const memPct=memKnown?100*r.mem_used_mib/(r.mem_gb*1024):0;
  const cpuTxt=cpuKnown?Math.round(r.cpu_pct)+'%':(running?'…':'&ndash;');
  const memUsed=memKnown?(r.mem_used_mib>=1024?((r.mem_used_mib/1024).toFixed(2)+' GiB'):(Math.round(r.mem_used_mib)+' MiB')):'';
  const memHtml=memKnown?'<strong>'+crfEsc(memUsed)+'</strong><span> / '+crfEsc(r.mem_gb)+' GiB</span>':(running?'…':'&ndash;');
  return {elapsedHtml,cpuPct,cpuTxt,memPct,memHtml};
}
function crfEmptyFleetHtml(d){
  return '<div class="crf-empty"><span class="crf-ball"></span>'+
    '<div><strong>No managed runners</strong><div class="crf-muted">Configured for '+crfEsc(d.configured||0)+' — start the fleet to register them with GitHub.</div></div>'+
    '<uui-button size="sm" data-crf-mutation'+(crfDark()?' class="dark"':'')+(d.config_error?' disabled':'')+' onclick="crfAction(\'start\')">Start the fleet</uui-button></div>';
}
function crfActivityWhen(iso){
  const t=Date.parse(iso||''); if(isNaN(t))return '—';
  const age=Math.max(0,Date.now()-t), minute=60000, hour=60*minute, day=24*hour;
  if(age<minute)return 'now';
  if(age<hour)return Math.floor(age/minute)+'m ago';
  if(age<day)return Math.floor(age/hour)+'h ago';
  if(age<7*day)return Math.floor(age/day)+'d ago';
  return new Date(t).toLocaleDateString([], {month:'short',day:'numeric'});
}
function crfRenderActivity(d){
  const box=document.getElementById('crf-activity'), body=document.getElementById('crf-activity-body');
  if(!box||!body)return;
  const rows=Array.isArray(d.recent_activity)?d.recent_activity.slice(0,10):[];
  if(!rows.length){box.style.display='none';body.innerHTML='';return;}
  box.style.display='block';
  body.innerHTML=rows.map(a=>{
    const when=crfActivityWhen(a.completed_at);
    const conclusion=String(a.conclusion||'unknown'), cls=conclusion==='success'?'crf-c-ok':'crf-activity-'+conclusion;
    return '<div class="crf-activity-row">'+
      '<span class="crf-activity-time" title="'+crfEsc(a.completed_at||'')+'">'+crfEsc(when)+'</span>'+
      '<span class="crf-activity-pool">'+crfEsc(a.pool_id||'unknown')+'</span>'+
      '<span class="crf-activity-job" title="'+crfEsc(a.job||'')+'">'+crfEsc(a.job||'unnamed job')+'</span>'+
      '<span class="crf-activity-result '+cls+'">'+crfEsc(conclusion)+'</span></div>';
  }).join('');
}

window.CRF_DISMISSED_WARNING='';
function crfDismissWarning(){
  const warn=document.getElementById('crf-warn');
  if(!warn)return;
  window.CRF_DISMISSED_WARNING=warn.dataset.warningKey||'';
  warn.style.display='none';
}

function crfRefresh(){
  // In-flight guard: never stack a new status poll while the previous is still
  // outstanding, so a slow backend can't spiral into overlapping polls.
  if(!crfFleetActive()) return;
  if(window.__crfBusyStatus){ window.__crfRefreshAgain=true; return; }
  window.__crfBusyStatus=true;
  crfPost({action:'status-json'}).then(d=>{
    if(!d||d.schema_version!==2||!Array.isArray(d.runners)||!Array.isArray(d.pools)) throw new Error('unsupported or malformed Fleet snapshot');
    window.CRF_LAST=d;
    window.CRF_CONFIG_INVALID=!!d.config_error;
    const warn=document.getElementById('crf-warn');
    const blocked=(d.pools||[]).find(p=>p&&p.blocked_reason);
    const warnText=d.config_error?('Configuration error: '+d.config_error):(d.warning||(blocked&&('Scaling blocked: '+blocked.blocked_reason)));
    if(warn){
      if(warnText&&window.CRF_DISMISSED_WARNING!==warnText){
        const detail=blocked&&blocked.blocked_reason==='cpu_exhausted'?'host CPU is saturated; scale requests are queued until load drops.':
          blocked&&blocked.blocked_reason==='memory_exhausted'?'host memory is saturated; scale requests are queued until capacity is available.':'';
        warn.dataset.warningKey=warnText;
        warn.innerHTML='<img src="/plugins/ci-runner-farm/assets/icons/warning.svg" alt=""><strong>'+crfEsc(warnText)+'</strong>'+
          (detail?'<span class="crf-warning-detail">&mdash; '+crfEsc(detail)+'</span>':'')+
          '<button type="button" class="crf-fleet-warning-dismiss" onclick="crfDismissWarning()">Dismiss</button>';
        warn.style.display='flex';
      } else if(!warnText||window.CRF_DISMISSED_WARNING===warnText){ warn.textContent=''; warn.style.display='none'; }
    }
    document.querySelectorAll('[data-crf-mutation]').forEach(b=>b.disabled=!!d.config_error);
    const sec=document.getElementById('crf-sec');
    if(sec){ if(d.security){ sec.innerHTML='<i class="fa fa-lock" aria-hidden="true"></i> '+crfEsc(d.security); sec.style.display='block'; } else { sec.textContent=''; sec.style.display='none'; } }
    // Runners still on a previous baked config after a settings change — the reconciler
    // recycles them onto the new config as they go idle (busy jobs finish first).
    const mig=document.getElementById('crf-migrate');
    if(mig){ if(d.stale>0){ mig.innerHTML='<i class="fa fa-refresh" aria-hidden="true"></i> '+crfEsc(d.stale+' runner'+(d.stale>1?'s':'')+' updating or retiring — recycling as they go idle, so running jobs finish first.'+(d.blocked_capacity>0?' '+d.blocked_capacity+' currently blocked by active or starting work.':'')); mig.style.display='block'; } else { mig.textContent=''; mig.style.display='none'; } }
    const rs=(d.runners||[]).slice().sort((a,b)=>Number(CRF_PINNED_RUNNERS.has(String(b.name)))-Number(CRF_PINNED_RUNNERS.has(String(a.name))));
    crfRenderPools(d);
    crfRenderActivity(d);
    const up=rs.filter(r=>r.state==='running').length;
    const busy=rs.filter(r=>r.state==='running'&&r.phase==='busy').length;
    const idle=rs.filter(r=>r.state==='running'&&r.phase==='idle').length;
    crfSetShellState(up,busy);crfRenderLoad(d,rs,busy);
    const put=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
    put('crf-s-up',up); put('crf-s-busy',busy); put('crf-s-idle',idle);
    put('crf-strip-up',up);put('crf-strip-busy',busy);
    const backend=d.backend||{}, compatibility=d.compatibility||{};
    const assigned=crfAssignedDemand(d);
    put('crf-s-assigned',backend.effective==='scaleset'?(assigned===null?'—':assigned):busy);
    put('crf-s-backend',(backend.requested||'?')+' → '+(backend.effective||'?'));
    put('crf-s-transition',backend.transition_phase||'?');
    const begin=document.getElementById('crf-begin-migration'), rollback=document.getElementById('crf-rollback-backend'), backendReason=document.getElementById('crf-backend-reason');
    const canBegin=!CRF_BACKEND_PENDING&&!d.config_error&&backend.requested==='scaleset'&&backend.effective==='classic'&&!!compatibility.valid;
    const canRollback=!CRF_BACKEND_PENDING&&!d.config_error&&(backend.effective==='scaleset'||(backend.transition_phase&&backend.transition_phase!=='classic_active'));
    if(begin){begin.disabled=!canBegin;begin.textContent=backend.transition_phase&&backend.transition_phase!=='classic_active'?'Continue fleet migration':'Begin fleet migration';}
    if(rollback)rollback.disabled=!canRollback;
    const migrationNeedsGate=backend.requested==='scaleset'||backend.effective==='scaleset'||(backend.transition_phase&&backend.transition_phase!=='classic_active');
    if(backendReason)backendReason.textContent=!migrationNeedsGate||compatibility.valid?'':('Migration blocked: '+(compatibility.reason||'compatibility gate not ready'));
    // The manual scale target must start from the live fleet size, rather than a
    // stale template default. Do not replace a value while the operator is typing.
    const scale=document.getElementById('crf-n');
    if(scale && document.activeElement!==scale) scale.value=d.count;
    const scaleButton=document.getElementById('crf-scale-button');
    const scaleWrap=document.getElementById('crf-scale-wrap');
    const scaleLabel=document.getElementById('crf-scale-label');
    if(scaleWrap) scaleWrap.style.display=d.mode==='pools'?'none':'flex';
    if(scale && d.mode!=='pools'){
      scale.disabled=!!d.config_error;
      scale.min=d.autoscale_enabled?Number(d.count)+1:0;
      scale.max=d.autoscale_enabled?40:20;
      if(d.autoscale_enabled) scale.max=d.autoscale_max;
      scale.setAttribute('aria-label',d.autoscale_enabled?'Scale up the fleet within the autoscale maximum':'Scale fleet to this runner count');
      scale.title=d.autoscale_enabled?'Immediately adds runners up to the Autoscale max. The autoscaler manages scale-down afterward.':'';
    }
    if(scaleButton){ scaleButton.disabled=!!d.config_error||(!!d.autoscale_enabled&&Number(d.count)>=Number(d.autoscale_max)); scaleButton.title=scale&&scale.title; }
    if(scaleButton) scaleButton.textContent=d.autoscale_enabled?'Scale up to':'Scale to';
    if(scaleLabel) scaleLabel.textContent=d.autoscale_enabled?'Scale up to':'Scale to';
    if(scaleWrap) scaleWrap.title=scale&&scale.title;
    put('crf-s-as',d.autoscale||'off'); put('crf-s-iu',d.image_autoupdate||'off');
    const tb=document.getElementById('crf-bays-body'); if(!tb) return;
    if(d.mode==='pools')crfCollectPoolRows(tb);
    // Capture the open drawer's LIVE scroll before the rebuild below destroys the
    // node, so crfDrawerMount can restore the user's position (not snap to tail).
    const odr=window.CRF_DRAWER&&document.querySelector('.crf-bay-drawer[data-for="'+crfSelectorValue(window.CRF_DRAWER)+'"]');
    if(odr){ window.CRF_DRAWER_PINNED=crfDrawerPinned(odr); window.CRF_DRAWER_SCROLL=odr.scrollTop; }
    if(!rs.length){
      tb.innerHTML=crfEmptyFleetHtml(d);
      crfPlacePoolRows(d,tb);
      crfCloseRunnerMenu();
      return;
    }
    const dark=crfDark()?' class="dark"':'';
    // In-place fast-path: rebuilding crf-bays-body's innerHTML every 5s recreates every
    // <uui-badge> web component and drops keyboard focus / text selection on each poll.
    // Most polls are steady-state — same runners and jobs, only CPU/mem/elapsed ticking —
    // so when the STRUCTURE is unchanged we refresh just those volatile cells in place and
    // leave the rows (and the open drawer sibling) alive. Any structural change (runner
    // added/removed, phase flip, new job, theme or drawer toggle) changes the signature
    // and falls through to the full rebuild below. busy-with-job_started is in the
    // signature so the .crf-elapsed span's presence always matches what the row was built
    // with — the in-place branch can then update it without ever needing to create it.
    const sig=JSON.stringify([dark,window.CRF_DRAWER,rs.map(r=>[r.name,r.pool,r.retiring,r.completed,r.state,r.phase,r.job,r.repo,r.run_id,r.pr,r.branch,r.cpus,r.mem_gb,r.started_at,r.state==='running'&&r.phase==='busy'&&!!r.job_started])]);
    if(tb.__crfSig===sig && tb.querySelector('.crf-bay[data-name]')){
      rs.forEach(r=>{
        const row=tb.querySelector('.crf-bay[data-name="'+(window.CSS&&CSS.escape?CSS.escape(r.name):r.name)+'"]'); if(!row) return;
        const v=crfVolatile(r);
        const u=row.querySelectorAll('.crf-usage');
        if(u[0]) u[0].innerHTML=crfBar(v.cpuPct)+'<span class="crf-uval">'+v.cpuTxt+'</span>';
        if(u[1]) u[1].innerHTML=crfBar(v.memPct)+'<span class="crf-uval crf-mem-value">'+v.memHtml+'</span>';
        const el=row.querySelector('.crf-elapsed');
        if(el&&r.job_started){ const e=crfElapsed(r.job_started); if(e){ el.textContent=e.txt; el.title='running for '+e.txt; el.className='crf-elapsed'+(e.m>=120?' crf-el-hot':e.m>=30?' crf-el-warn':''); } }
      });
      crfPlacePoolRows(d,tb);
      crfDrawerMount();
      crfSyncRunnerMenu();
      return;
    }
    tb.__crfSig=sig;
    tb.innerHTML=rs.map(r=>{
      const running=r.state==='running';
      const ph=running?r.phase:(r.completed?'completed':'exited');
      const ball=running?('crf-ball-'+r.phase):(r.completed?'crf-ball-idle':'crf-ball');
      const bvar=ph==='busy'?'orange':(ph==='idle'||ph==='completed')?'green':ph==='error'?'red':'gray';
      let jobHtml;
      const v=crfVolatile(r);
      if(running&&r.phase==='busy'){
        const repoShort=r.repo?crfEsc(String(r.repo).split('/').pop()):'';
        const runOk=/^\d+$/.test(r.run_id||'');
        const jobTxt=crfEsc(r.job||'\u2014');
        const core=(repoShort?'<span class="crf-repo" title="'+crfEsc(r.repo)+'">'+repoShort+'</span> \u00b7 ':'')+jobTxt;
        jobHtml=(runOk&&r.repo)?'<a href="https://github.com/'+crfEsc(r.repo)+'/actions/runs/'+r.run_id+'" target="_blank" rel="noopener" title="open run">'+core+'</a>':core;
        if(/^\d+$/.test(r.pr||'')&&r.repo) jobHtml+='<a class="crf-ref" href="https://github.com/'+crfEsc(r.repo)+'/pull/'+r.pr+'" target="_blank" rel="noopener">#'+r.pr+'</a>';
        else if(r.branch) jobHtml+='<span class="crf-ref">'+crfEsc(r.branch)+'</span>';
        jobHtml+=v.elapsedHtml;
      } else {
        jobHtml=crfEsc(r.completed?'one-shot job completed':(running?'— waiting':r.state));
      }
      const jobCls=(running&&r.phase==='busy'&&r.job)||r.completed?'crf-job':'crf-job crf-muted';
      return '<div class="crf-bay" data-name="'+crfEsc(r.name)+'" tabindex="0" role="button" aria-expanded="'+(window.CRF_DRAWER===r.name?'true':'false')+'" aria-label="Runner '+crfEsc(r.name)+', toggle log">'+
        '<span class="crf-ball '+ball+'"></span>'+
        '<span class="crf-name">'+crfEsc(r.name)+(r.started_at?'<span class="crf-runner-age">up '+crfEsc(crfUptime(r.started_at))+'</span>':'')+(r.pool?'<span class="crf-pool-badge">'+crfEsc(r.pool)+'</span>':'')+'</span>'+
        '<span class="crf-phase"><uui-badge variant="'+bvar+'" size="xs"'+dark+'>'+crfEsc(ph)+'</uui-badge></span>'+
        '<span class="'+jobCls+'" title="'+crfEsc(r.job||'')+'">'+jobHtml+'</span>'+
        '<span class="crf-usage">'+crfBar(v.cpuPct)+'<span class="crf-uval">'+v.cpuTxt+'</span></span>'+
        '<span class="crf-usage">'+crfBar(v.memPct)+'<span class="crf-uval crf-mem-value">'+v.memHtml+'</span></span>'+
        '<span class="crf-recycle crf-runner-menu-button" tabindex="0" role="button" aria-haspopup="menu" aria-expanded="'+(CRF_RUNNER_MENU===r.name?'true':'false')+'" aria-label="Actions for '+crfEsc(r.name)+'" title="Runner actions"><img src="/plugins/ci-runner-farm/assets/icons/ellipsis.svg" alt="" aria-hidden="true"></span>'+
