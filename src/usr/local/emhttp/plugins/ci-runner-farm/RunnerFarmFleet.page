        '<div class="crf-bays"><div class="crf-bay crf-bay-head"><span></span><span>Runner</span><span>Phase</span><span>Job</span><span>CPU</span><span>Memory</span><span></span></div><div class="crf-pool-bays-body"></div></div>';
    }
