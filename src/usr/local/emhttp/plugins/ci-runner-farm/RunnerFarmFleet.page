  pressure.hidden=!pools.length&&!partialText;pressure.innerHTML=(pools.length?'<span class="crf-queue-pressure-label">Pressure</span>'+pools.map(([pool,count])=>'<span class="crf-queue-pressure-chip">'+crfEsc(pool)+' '+count+'</span>').join(''):'')+(partialText?'<span class="crf-queue-pressure-partial">'+crfEsc(partialText)+'</span>':'');
