function crfQueueWait(value){
  const stamp=Date.parse(value||'');if(!Number.isFinite(stamp))return '\u2013';
  const seconds=Math.max(0,Math.floor((Date.now()-stamp)/1000));
  if(seconds<60)return seconds+'s';const minutes=Math.floor(seconds/60);return minutes<60?minutes+'m':Math.floor(minutes/60)+'h '+String(minutes%60).padStart(2,'0')+'m';
