      '<span class="crf-queue-rail" aria-hidden="true"></span><span class="crf-queue-workflow"><strong title="'+crfEsc(job.workflow||'Queued workflow')+'">'+crfEsc(job.workflow||'Queued workflow')+'</strong><small>'+crfEsc(repo)+'</small></span>'+
      '<span class="crf-queue-labels" title="'+crfEsc(job.labels||'Labels pending')+'">'+crfEsc(job.labels||'labels pending')+'</span><span class="crf-queue-pool'+(pool?'':' is-unknown')+'">'+crfEsc(pool||'pending')+'</span>'+
      '<span class="crf-queue-reason" title="'+crfEsc(job.reason||'waiting for runner')+'">'+crfEsc(job.reason||'waiting for runner')+'</span><span class="crf-queue-wait">'+crfEsc(crfQueueWait(job.created_at))+'</span>'+
