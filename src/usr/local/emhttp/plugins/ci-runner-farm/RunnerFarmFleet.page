function crfBackendAction(action){
  if(CRF_BACKEND_PENDING)return;
  const d=window.CRF_LAST||{}, b=d.backend||{}, c=d.compatibility||{};
  const assigned=(d.pools||[]).reduce((n,p)=>n+Math.max(0,Number(p.assigned_jobs)||0),0);
  const busy=(d.runners||[]).filter(r=>r.state==='running'&&r.phase==='busy').length;
  const idle=(d.runners||[]).filter(r=>r.state==='running'&&r.phase==='idle').length;
  const payload={action,expected_config_revision:d.config_revision,
    expected_ownership_revision:b.ownership_revision,
    expected_compatibility_record_id:c.record_id,
    expected_transition_revision:b.transition_revision};
  const run=()=>{
    CRF_BACKEND_PENDING=true;crfRefresh();
    crfPost(payload).then(o=>{crfLog(o);crfToast(o.ok?(action==='begin-migration'?'Migration advanced':'Rollback advanced'):('Backend operation failed'+(o.log?': '+o.log:'')));})
      .catch(e=>{crfToast('Backend operation failed');console.error(e);})
      .finally(()=>{CRF_BACKEND_PENDING=false;crfRefresh();});
  };
  const consequence=action==='begin-migration'?'Classic remains effective until its remote eligibility barrier is proven.':'Scale sets become ineligible first; assigned JIT work drains before classic is reactivated.';
  const text='Busy '+busy+' · idle '+idle+' · assigned '+assigned+'\nConfig '+String(d.config_revision||'').slice(0,12)+' · transition '+String(b.transition_revision||'').slice(0,12)+'\n\n'+consequence;
  if(window.swal)swal({title:action==='begin-migration'?'Begin fleet migration?':'Roll back to classic?',text,type:'warning',showCancelButton:true,confirmButtonText:action==='begin-migration'?'Begin migration':'Begin rollback'},ok=>{if(ok)run();});
  else if(window.confirm(text))run();
}

function crfElapsed(iso){
  const t=Date.parse(iso); if(isNaN(t)) return null;
  const m=Math.floor((Date.now()-t)/60000);
  return {m, txt: m<1?'<1m': m<60? m+'m' : Math.floor(m/60)+'h'+String(m%60).padStart(2,'0')};
}
function crfBar(pct){
  const p=Math.max(0,Math.min(100,Math.round(pct)));
  const cls=p>90?' crf-hot':p>60?' crf-mid':'';
  return '<span class="crf-ubar'+cls+'"><span style="width:'+p+'%"></span></span>';
}
/* The per-poll VOLATILE cells — the elapsed timer and the CPU/mem bars, which tick
   every 5s for a busy runner. Factored out so the full row builder and crfRefresh's
   in-place fast-path render them identically from ONE source of truth (no drift). */
function crfVolatile(r){
  const running=r.state==='running';
  let elapsedHtml='';
  if(running&&r.phase==='busy'&&r.job_started){
    const e=crfElapsed(r.job_started);
    if(e) elapsedHtml=' <span class="crf-elapsed'+(e.m>=120?' crf-el-hot':e.m>=30?' crf-el-warn':'')+'" title="running for '+e.txt+'">'+e.txt+'</span>';
  }
  const cpuMax=(r.cpus&&r.cpus>0)?r.cpus*100:100;
  const cpuKnown=running&&r.cpu_pct>=0, memKnown=running&&r.mem_used_mib>=0&&r.mem_gb;
  const cpuPct=cpuKnown?(100*r.cpu_pct/cpuMax):0;
  const memPct=memKnown?100*r.mem_used_mib/(r.mem_gb*1024):0;
  const cpuTxt=cpuKnown?Math.round(r.cpu_pct)+'%':(running?'…':'&ndash;');
  const memTxt=memKnown?((r.mem_used_mib>=1024?( (r.mem_used_mib/1024).toFixed(1)+'g'):(r.mem_used_mib+'m'))+'/'+r.mem_gb+'g'):(running?'…':'&ndash;');
  return {elapsedHtml,cpuPct,cpuTxt,memPct,memTxt};
}
function crfEmptyFleetHtml(d){
  return '<div class="crf-empty"><span class="crf-ball"></span>'+
    '<div><strong>No managed runners</strong><div class="crf-muted">Configured for '+crfEsc(d.configured||0)+' — start the fleet to register them with GitHub.</div></div>'+
    '<uui-button size="sm" data-crf-mutation'+(crfDark()?' class="dark"':'')+(d.config_error?' disabled':'')+' onclick="crfAction(\'start\')">Start the fleet</uui-button></div>';
