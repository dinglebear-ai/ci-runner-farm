    const control=fleet.querySelector('.crf-pool-control');
    control.style.display=retiring?'none':'flex';
    if(!retiring){
      const input=control.querySelector('input'),button=control.querySelector('uui-button'),trigger=control.querySelector('.crf-pool-scale-trigger'),editor=control.querySelector('.crf-pool-scale-editor'),editing=control.dataset.editing==='true';
      trigger.hidden=editing;editor.hidden=!editing;
      control.querySelector('.crf-pool-control-label').textContent=controlLabel;
      input.dataset.pool=id;input.min=String(scaleSet?0:(auto?Number(p.count)+1:1));input.max=String(auto?numericMax:64);
      input.setAttribute('aria-label',controlLabel+' '+id+' pool');
      if(document.activeElement!==input)input.value=String(p.count);
      button.dataset.scalePool=id;button.title=controlLabel+' '+id;button.textContent=scaleSet?'Set':'Scale';
      button.disabled=!!(pending||atMax||d.config_error);
      if(pending)button.setAttribute('aria-busy','true');else button.removeAttribute('aria-busy');
    }
    if(section.children[poolIndex]!==fleet)
      section.insertBefore(fleet,section.children[poolIndex]||null);
  });
  section.querySelectorAll('.crf-pool-fleet').forEach(fleet=>{
    if(!wanted.has(String(fleet.dataset.pool)))fleet.remove();
  });
}
function crfCollectPoolRows(tb){
