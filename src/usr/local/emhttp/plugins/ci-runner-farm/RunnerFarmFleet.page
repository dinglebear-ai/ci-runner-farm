document.getElementById('crf-run-queue')?.addEventListener('click',event=>{const button=event.target.closest('[data-queue-cancel]');if(!button||button.disabled)return;const row=button.closest('[data-run-id][data-repo]');if(row)crfCancelQueued(row.dataset.repo,row.dataset.runId,row.querySelector('.crf-queue-workflow strong')?.textContent||'this workflow');});
function crfQueued(){
  if(!crfFleetActive()) return;
  crfPost({action:'queued-json'}).then(d=>{
    const el=document.getElementById('crf-s-q'); if(!el) return;
    const q=(typeof d.queued==='number'&&d.queued>=0)?d.queued:null;
    const known=Number(d.known_queued),display=q===null?(Number.isFinite(known)&&known>0?'\u2265'+known:'\u2013'):String(q);
    el.textContent=display;el.classList.toggle('crf-c-busy',q!==null?q>0:known>0);
    const strip=document.getElementById('crf-strip-queue');if(strip)strip.textContent=display;
    CRF_QUEUE_SNAPSHOT=d;if(q!==null){CRF_QUEUE_DEPTH.push(q);while(CRF_QUEUE_DEPTH.length>40)CRF_QUEUE_DEPTH.shift();}
