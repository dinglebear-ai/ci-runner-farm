  menu.hidden=!open;button.setAttribute('aria-expanded',open?'true':'false');
}
document.addEventListener('click',e=>{if(!e.target.closest('.crf-hero-menu-wrap'))crfToggleHeroMenu(false);});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!crfModalActive())crfToggleHeroMenu(false);});
const CRF_BUSY_POOLS=new Set();
let CRF_PINNED_RUNNERS=new Set();
