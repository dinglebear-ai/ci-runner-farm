<script>
/* Poll only when the Fleet tab is actually on screen. document.hidden covers a
   backgrounded browser tab; offsetParent covers the inactive dynamix sub-tab
   (all tabs share one document, so document.hidden stays false on Settings/Image
   while Fleet's pollers would otherwise keep hitting docker on the NAS). */
function crfFleetActive(){ const b=document.getElementById('crf-runner-tables'); return !document.hidden && !!b && b.offsetParent!==null; }
let crfUserLog=false;
function crfLog(o){ crfUserLog=true; document.getElementById('crf-log').innerHTML = crfColorize(o.log||JSON.stringify(o)); }
/* Until the user triggers an action, the Fleet log shows live farm activity
   (autoscale daemon log) instead of sitting on a placeholder. */
function crfFarmLog(){
  if(crfUserLog||!crfFleetActive()) return;
  crfPost({action:'farm-log'}).then(d=>{
    if(crfUserLog||!d.log) return;
    const el=document.getElementById('crf-log');
    el.innerHTML=crfColorize(d.log); el.scrollTop=el.scrollHeight;
  }).catch(()=>{});
}
crfFarmLog(); setInterval(crfFarmLog,10000);
/* Lightweight theme-following toast for action feedback. */
const CRF_TOAST_MSG={start:'Fleet started',stop:'Fleet stopped',restart:'Fleet restarted',validate:'Validation finished'};
function crfDoAction(a){ if(window.CRF_CONFIG_INVALID&&a!=='stop')return; crfPost({action:a}).then(o=>{crfLog(o); crfRefresh(); if(o.ok!==false) crfToast(CRF_TOAST_MSG[a]||a); else crfToast((CRF_TOAST_MSG[a]||a)+' failed'+(o.error?': '+o.error:'')); }).catch(e=>{ crfToast((CRF_TOAST_MSG[a]||a)+' failed'); console.error('ci-runner-farm '+a+':',e); }); }
function crfAction(a){
  /* Stop/Restart kill whatever the runners are building — confirm with the
     live impact when any runner is mid-job (sweetalert ships with the webgui). */
  if((a==='stop'||a==='restart')&&window.swal){
    const busy=((window.CRF_LAST||{}).runners||[]).filter(r=>r.state==='running'&&r.phase==='busy');
    if(busy.length){
      const lines=busy.map(r=>r.name+(r.job?' — '+r.job:'')).join('\n');
      swal({title:(a==='stop'?'Stop':'Restart')+' the fleet?',
        text:busy.length+' runner'+(busy.length>1?'s are':' is')+' mid-job:\n'+lines+'\n\nTheir jobs will fail and re-queue.',
        type:'warning',showCancelButton:true,confirmButtonText:a==='stop'?'Stop fleet':'Restart fleet',cancelButtonText:'Cancel'},
        ok=>{ if(ok) crfDoAction(a); });
      return;
    }
  }
  crfDoAction(a);
}
function crfScale(){ if(window.CRF_CONFIG_INVALID)return; const n=document.getElementById('crf-n').value; crfPost({action:'scale',n}).then(o=>{crfLog(o); crfRefresh(); if(o.ok!==false) crfToast('Scaled to '+n); else crfToast('Scale failed'+(o.error?': '+o.error:''));}).catch(e=>{ crfToast('Scale failed'); console.error('ci-runner-farm scale:',e); }); }
const CRF_POOL_PENDING=new Set();
let CRF_BACKEND_PENDING=false;
function crfSelectorValue(value){ return window.CSS&&CSS.escape?CSS.escape(value):String(value).replace(/["\\]/g,'\\$&'); }
function crfScalePool(pool){
  if(window.CRF_CONFIG_INVALID||CRF_POOL_PENDING.has(pool))return;
  const input=document.querySelector('.crf-pool-scale[data-pool="'+crfSelectorValue(pool)+'"]'); if(!input)return;
  const n=input.value; CRF_POOL_PENDING.add(pool); crfRenderPools(window.CRF_LAST||{});
  const d=window.CRF_LAST||{}, scaleSet=d.backend&&d.backend.effective==='scaleset';
  const request=scaleSet?{action:'prewarm',pool,n,expected_config_revision:d.config_revision}:{action:'scale',pool,n};
  crfPost(request).then(o=>{
    crfLog(o);
    if(o.ok===false) crfToast('Scale failed'+(o.error?': '+o.error:''));
    else crfToast((scaleSet?'Prewarm target set for ':'Scale target set for ')+pool+' at '+n);
  }).catch(e=>{crfToast('Scale failed');console.error('ci-runner-farm pool scale:',e);})
    .finally(()=>{CRF_POOL_PENDING.delete(pool);crfRefresh();});
}
function crfRenderPools(d){
  const section=document.getElementById('crf-pools-section'); if(!section)return;
  const pools=(d.pools||[]).slice();
  if(d.mode!=='pools'){section.style.display='none';return;}
  const configured=new Set(pools.map(p=>String(p.id)));
  const legacy=(d.runners||[]).filter(r=>!r.pool||!configured.has(String(r.pool)));
  if(legacy.length) pools.push({id:'default',label:'',up:legacy.filter(r=>r.state==='running').length,
    busy:legacy.filter(r=>r.state==='running'&&r.phase==='busy').length,
    idle:legacy.filter(r=>r.state==='running'&&r.phase==='idle').length,retiring:legacy.length,configured:0});
  section.style.display='block';
  const poolTitle=id=>({rust:'Rust',python:'Python',typescript:'TypeScript',go:'Go',ops:'Ops',
    system:'System','residential-egress':'Residential egress',default:'Retiring'}[id]||
    String(id).split(/[-_]/).map(s=>s?s.charAt(0).toUpperCase()+s.slice(1):s).join(' '));
  const wanted=new Set();
  pools.forEach((p,poolIndex)=>{
    const id=String(p.id);wanted.add(id);
    const scaleSet=d.backend&&d.backend.effective==='scaleset', auto=!!d.autoscale_enabled, pending=CRF_POOL_PENDING.has(p.id), retiring=!p.label||Number(p.configured)===0;
    const numericMax=String(p.max)==='auto'?64:Number(p.max), atMax=!scaleSet&&auto&&Number(p.count)>=numericMax;
    const controlLabel=scaleSet?'Prewarm to':(auto?'Scale up to':'Scale to');
    const state=(p.retiring?'<span class="crf-pool-state">retiring '+crfEsc(p.retiring)+'</span>':'')+
      (p.stale?'<span class="crf-pool-state"> updating '+crfEsc(p.stale)+'</span>':'')+
      (p.pending?'<span class="crf-pool-state"> draining '+crfEsc(p.pending)+'</span>':'')+
      (p.blocked_reason?'<span class="crf-pool-state"> blocked: '+crfEsc(p.blocked_reason)+'</span>':'');
    const selector=p.label||'retiring', title=poolTitle(String(p.id));
    let fleet=section.querySelector('.crf-pool-fleet[data-pool="'+crfSelectorValue(id)+'"]');
    if(!fleet){
      fleet=document.createElement('section');fleet.className='crf-pool-fleet';fleet.dataset.pool=id;
      fleet.innerHTML='<div class="crf-pool-fleet-meta"><span class="crf-pool-route"></span><span class="crf-pool-metrics"></span><span class="crf-pool-state-wrap"></span><span class="crf-pool-control" style="display:none"><span class="crf-pool-control-label"></span><input class="crf-pool-scale" type="number"><uui-button class="orange" size="xs"></uui-button></span></div>'+
        '<div class="crf-bays"><div class="crf-bay crf-bay-head"><span></span><span class="crf-pool-title"></span><span>Phase</span><span>Job</span><span>CPU</span><span>Memory</span><span></span></div><div class="crf-pool-bays-body"></div></div>';
    }
    // REVIEW(crf-v3q.13.9): Reconcile stable pool sections and controls instead
    // of replacing their subtree every poll. Focus, caret, runner rows, open
    // drawers, and drawer scroll therefore survive ordinary metric updates.
    const route=fleet.querySelector('.crf-pool-route');
    if(p.label){
      let copy=route.querySelector('.crf-pool-selector');
      if(!copy){route.textContent='';copy=document.createElement('button');copy.type='button';copy.className='crf-pool-selector';route.appendChild(copy);}
      copy.dataset.copy=p.label;copy.title='Copy runs-on: '+p.label;copy.textContent=selector;
    }else if(route.textContent!=='classic runners draining'){
      route.innerHTML='<span class="crf-pool-state">classic runners draining</span>';
    }
    fleet.querySelector('.crf-pool-metrics').innerHTML='<strong>up '+crfEsc(p.up)+'</strong> · busy '+crfEsc(p.busy)+' · idle '+crfEsc(p.idle)+
      (scaleSet?' · assigned '+crfEsc(Math.max(0,Number(p.assigned_jobs)||0))+' · capacity '+crfEsc(Math.max(0,Number(p.advertised_capacity)||0)):'')+
      (p.starting?' · starting '+crfEsc(p.starting):'')+(p.completed?' · completed '+crfEsc(p.completed):'')+(p.error?' · error '+crfEsc(p.error):'');
    fleet.querySelector('.crf-pool-state-wrap').innerHTML=state;
    fleet.querySelector('.crf-pool-title').textContent=title;
    const body=fleet.querySelector('.crf-pool-bays-body');body.dataset.poolBody=id;
    const control=fleet.querySelector('.crf-pool-control');
    control.style.display=retiring?'none':'flex';
    if(!retiring){
      const input=control.querySelector('input'),button=control.querySelector('uui-button');
      control.querySelector('.crf-pool-control-label').textContent=controlLabel;
      input.dataset.pool=id;input.min=String(scaleSet?0:(auto?Number(p.count)+1:1));input.max=String(auto?numericMax:64);
      input.setAttribute('aria-label',controlLabel+' '+id+' pool');
      if(document.activeElement!==input)input.value=String(p.count);
      button.dataset.scalePool=id;button.title=controlLabel+' '+id;button.textContent=scaleSet?'Set':'Scale';
      button.disabled=!!(pending||atMax||d.config_error);
      if(pending)button.setAttribute('aria-busy','true');else button.removeAttribute('aria-busy');
    }
    if(section.children[poolIndex]!==fleet)
      section.insertBefore(fleet,section.children[poolIndex]||null);
  });
  section.querySelectorAll('.crf-pool-fleet').forEach(fleet=>{
    if(!wanted.has(String(fleet.dataset.pool)))fleet.remove();
  });
}
