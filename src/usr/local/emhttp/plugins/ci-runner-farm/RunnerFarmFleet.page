function crfFleetActive(){ const b=document.getElementById('crf-runner-tables'); return !document.hidden && !!b && b.offsetParent!==null; }
function crfToggleHeroMenu(force){
  const menu=document.getElementById('crf-hero-menu'),button=document.getElementById('crf-hero-menu-button');
  if(!menu||!button)return;
