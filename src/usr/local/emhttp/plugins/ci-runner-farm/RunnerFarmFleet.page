let CRF_RUNNER_MENU='';
let CRF_KB_INDEX=-1;
let CRF_QUEUE_OPEN=false;
let CRF_QUEUE_SNAPSHOT={queued:-1,jobs:[],loading:true};
const CRF_QUEUE_DEPTH=[];
const CRF_QUEUE_CANCEL_PENDING=new Set();
const CRF_LOAD_POINTS=[];
function crfLoadPoint(point){
  if(!point||typeof point!=='object')return null;
  const cpu=Number(point.cpu_pct??point.cpu),total=Number(point.total),busyCount=Number(point.busy),busyPctValue=Number(point.busy_pct);
  if(!Number.isFinite(cpu)||cpu<0)return null;
  const busy=Number.isFinite(busyPctValue)?busyPctValue:(Number.isFinite(total)&&total>0&&Number.isFinite(busyCount)?100*busyCount/total:busyCount);
  if(!Number.isFinite(busy)||busy<0)return null;
  return {cpu:Math.max(0,Math.min(100,cpu)),busy:Math.max(0,Math.min(100,busy))};
}
function crfRenderLoad(snapshot,runners,busy){
  const supplied=Array.isArray(snapshot&&snapshot.load_history)?snapshot.load_history.map(crfLoadPoint).filter(Boolean).slice(-40):[];
  const running=(runners||[]).filter(r=>r.state==='running');
  const live=running.filter(r=>Number.isFinite(Number(r.cpu_pct))&&Number(r.cpu_pct)>=0);
  const known=running.length===0||live.length===running.length;
  const cpu=live.length?Math.max(0,Math.min(100,live.reduce((n,r)=>n+Number(r.cpu_pct),0)/live.length)):0;
  const busyPct=running.length?Math.max(0,Math.min(100,100*busy/running.length)):0;
