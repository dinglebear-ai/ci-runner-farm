  else if(known){CRF_LOAD_POINTS.push({cpu,busy:busyPct});while(CRF_LOAD_POINTS.length>40)CRF_LOAD_POINTS.shift();}
  const now=document.getElementById('crf-load-now');if(now)now.textContent=known?Math.round(cpu)+'%':'\u2013';
  const canvas=document.getElementById('crf-load-chart');if(!canvas)return;
  const width=Math.max(1,Math.round(canvas.clientWidth)),height=34,dpr=window.devicePixelRatio||1;
  canvas.width=Math.round(width*dpr);canvas.height=Math.round(height*dpr);
  const ctx=canvas.getContext('2d');ctx.scale(dpr,dpr);ctx.clearRect(0,0,width,height);
  const empty={cpu:0,busy:0};
  const points=CRF_LOAD_POINTS.length>1?CRF_LOAD_POINTS:CRF_LOAD_POINTS.length===1?[CRF_LOAD_POINTS[0],CRF_LOAD_POINTS[0]]:[empty,empty];
  const xy=(p,i,key)=>[i*(width/(points.length-1)),32-30*(p[key]/100)];
  ctx.beginPath();points.forEach((p,i)=>{const [x,y]=xy(p,i,'busy');i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.strokeStyle='#c4c4c4';ctx.lineWidth=1.6;ctx.lineJoin='round';ctx.lineCap='round';ctx.stroke();
  ctx.beginPath();points.forEach((p,i)=>{const [x,y]=xy(p,i,'cpu');i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.lineTo(width,34);ctx.lineTo(0,34);ctx.closePath();ctx.fillStyle='rgba(255,140,47,.14)';ctx.fill();
  ctx.beginPath();points.forEach((p,i)=>{const [x,y]=xy(p,i,'cpu');i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.strokeStyle='#ff8c2f';ctx.lineWidth=1.8;ctx.lineJoin='round';ctx.lineCap='round';ctx.stroke();
  const [nowX,nowY]=xy(points[points.length-1],points.length-1,'cpu');ctx.beginPath();ctx.arc(nowX,nowY,2.6,0,Math.PI*2);ctx.fillStyle='#ff8c2f';ctx.fill();
}
function crfSetShellState(up,busy){
  const shell=document.getElementById('crf-shell-status'),label=document.getElementById('crf-shell-status-label'),count=document.getElementById('crf-shell-count');
  if(count)count.textContent=String(up);
  if(shell&&label){shell.className='crf-app-status '+(up===0?'crf-app-status-down':busy>0?'crf-app-status-busy':'crf-app-status-idle');label.textContent=up===0?'Farm stopped':busy>0?(busy+' busy'):'All idle';}
