  const points=CRF_QUEUE_DEPTH.length?CRF_QUEUE_DEPTH:[0],max=Math.max(1,...points);ctx.strokeStyle='#e9bf41';ctx.lineWidth=1.6;ctx.lineJoin='round';ctx.lineCap='round';ctx.beginPath();
