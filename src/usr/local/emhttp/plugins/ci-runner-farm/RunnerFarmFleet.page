  const menu=document.getElementById('crf-runner-menu');if(!menu||!CRF_RUNNER_MENU)return false;
  const trigger=crfRunnerMenuTrigger(CRF_RUNNER_MENU);if(!trigger||!trigger.isConnected||trigger.offsetParent===null){crfCloseRunnerMenu();return false;}
