crfRefresh(); setInterval(crfRefresh,5000);
function crfToggleQueue(force,refresh=true){
  const panel=document.getElementById('crf-run-queue'),stat=document.querySelector('.crf-queue-stat');if(!panel)return;
  CRF_QUEUE_OPEN=typeof force==='boolean'?force:panel.hidden;
  panel.hidden=!CRF_QUEUE_OPEN;if(stat)stat.setAttribute('aria-expanded',CRF_QUEUE_OPEN?'true':'false');
  if(CRF_QUEUE_OPEN){crfRenderQueue(CRF_QUEUE_SNAPSHOT);if(refresh)crfQueued();panel.scrollIntoView({block:'nearest'});}
