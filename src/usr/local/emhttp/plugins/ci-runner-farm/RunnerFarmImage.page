  .crfi-copy{padding:0;border:0;background:transparent;color:var(--crf-busy);font:600 11.5px/normal clear-sans,ui-sans-serif,system-ui,sans-serif;cursor:pointer}
  .crfi-actions .crf-button:not(.crf-button-primary){line-height:normal}
  .crfi-log .crf-section-label{font-weight:600;letter-spacing:.08em}
  .crfi-log .crf-console-body{min-height:0;max-height:240px;padding:12px 0;background:#fff;font:12px/1.65 ui-monospace,Menlo,Consolas,monospace}
  .crfi-log-line{padding:2px 18px}
  .crfi-log-output{padding:0 18px}
  @media(max-width:760px){
    .crfi-overview{border-radius:12px}
    .crfi-overview-head{padding:14px;align-items:flex-start;gap:12px}
    .crfi-image-identity{width:100%;align-items:flex-start}
    .crfi-image-icon{width:38px;height:38px;border-radius:10px}
    .crfi-image-icon img{width:18px;height:18px}
    .crfi-image-copy{flex:1;min-width:0}
    .crfi-image-copy strong{font-size:19px;white-space:normal}
    .crfi-image-copy>span{margin-top:3px;font-size:12px;line-height:1.4;white-space:normal;overflow-wrap:anywhere}
    .crfi-actions{width:100%;margin-left:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .crfi-action-status{grid-column:1/-1;justify-self:start;min-height:30px}
    .crfi-actions .crf-button{width:100%;min-width:0;height:auto;min-height:46px;padding:8px 10px;line-height:1.25;white-space:normal;text-align:center}
    .crfi-actions .crf-button-primary{grid-column:1/-1}
    .crfi-overview-foot{padding:12px 14px;align-items:flex-start;gap:9px}
    .crfi-overview-foot>#crfi-ball{margin-top:7px}
    .crfi-tc-label{margin-top:5px}
    .crfi-toolchains{flex:1;min-width:0;gap:7px}
    .crfi-tc{min-height:44px;padding:10px 12px;font-size:11.5px}
    .crfi-facts-divider{display:none}
    .crfi-chips{width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
    .crfi-chip{min-width:0;min-height:34px;padding:6px 9px;white-space:normal;overflow-wrap:anywhere}
    .crfi-chip:first-child{grid-column:1/-1}
    .crfi-editor{border-radius:12px;overflow:hidden}
    .crfi-editor-head{min-height:54px;padding:10px 12px;align-items:flex-start}
    .crfi-path{flex:1;align-items:flex-start}
    .crfi-editor-icon{width:34px;height:34px;border-radius:9px}
    .crfi-path code{padding-top:6px;font-size:11px;line-height:1.45;white-space:normal;overflow-wrap:anywhere;word-break:break-word}
    .crfi-dot{left:25px;top:1px}
    .crfi-df-stats{display:none}
    .crfi-editor-body{min-height:58dvh;max-height:72dvh;overflow:hidden}
    #crfi-highlight,#crf-dockerfile{padding:14px;font-size:12px;line-height:1.65;white-space:pre;word-break:normal;overflow-wrap:normal;tab-size:2}
    #crfi-highlight{overflow:hidden}
    #crf-dockerfile{height:58dvh;min-height:420px;max-height:72dvh;resize:none;overflow:auto;overscroll-behavior:contain}
    .crfi-config-grid{grid-template-columns:1fr;gap:12px}
    .crfi-config-card{padding:14px;gap:12px;border-radius:12px}
    .crfi-config-head h2{font-size:11.5px}
    button.crfi-card-reset{width:44px!important;min-width:44px!important;height:44px!important;border:1px solid var(--crf-border)!important;border-radius:9px!important}
    button.crfi-card-reset img{width:14px;height:14px}
    .crfi-config-fields{grid-template-columns:1fr;row-gap:7px}
    .crfi-config-fields>label{text-align:left;margin-top:6px;white-space:normal}
    .crfi-config-fields input,.crfi-config-fields select{width:100%;height:44px;font-size:16px}
    .crfi-config-fields .crfi-number-row{width:100%}
    .crfi-config-fields .crfi-number-row input{width:min(150px,60%)}
    .crfi-log{border-width:1px;border-radius:12px;overflow:hidden}
    .crfi-log .crf-console-head{height:auto;min-height:48px;padding:9px 12px;flex-wrap:wrap}
    .crfi-log .crf-console-body{max-height:340px;padding:10px 0;font-size:11.5px;overflow-wrap:anywhere}
    .crfi-log-line,.crfi-log-output{padding-left:12px;padding-right:12px}
