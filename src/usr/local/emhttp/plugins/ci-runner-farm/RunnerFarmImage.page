<script>
const CRFI_CONFIG_REVISION = <?=json_encode($crfi_config_revision)?>;
const CRFI_DRAFT_KEY='ci-runner-farm:settings-draft:v1';
const CRFI_APPLIED_SETTINGS={
  IMAGE_SOURCE:<?=json_encode($crfi_image_source)?>,
  IMAGE:<?=json_encode($crfi_image_ref)?>,
  IMAGE_AUTOUPDATE:<?=json_encode($crfi_autoupdate)?>,
  IMAGE_AUTOUPDATE_INTERVAL:<?=json_encode($crfi_autoupdate_interval)?>,
  IMAGE_DRAIN_TIMEOUT:<?=json_encode($crfi_drain_timeout)?>
};
function crfiReadDraft(){
  let draft=null;try{draft=JSON.parse(sessionStorage.getItem(CRFI_DRAFT_KEY)||'null');}catch(_error){}
  if(!draft||draft.config_revision!==CRFI_CONFIG_REVISION||!draft.settings){
    try{sessionStorage.removeItem(CRFI_DRAFT_KEY);}catch(_error){}
    return {config_revision:CRFI_CONFIG_REVISION,settings:{}};
  }
  return draft;
}
function crfiRefreshSettingsDot(){
  const settings=document.querySelector('[data-crf-primary-key="settings"]');
  let dirty=false;try{dirty=!!(sessionStorage.getItem(CRFI_DRAFT_KEY)||sessionStorage.getItem('ci-runner-farm:pools-draft:v1'));}catch(_error){}
  if(settings&&!settings.hasAttribute('aria-current'))settings.classList.toggle('has-dirty',dirty);
}
/* The source UI treats Runner image source/rollout controls as the same staged
   Settings transaction as General. Preserve that contract across Unraid's
   separate .page routes: stage into sessionStorage, show the Settings dot, and
   let General's review/apply flow commit the complete draft atomically. */
function crfiStageSettings(updates){
  const draft=crfiReadDraft();
  for(const [key,value] of Object.entries(updates)){
    const normalized=String(value);
    if(normalized===String(CRFI_APPLIED_SETTINGS[key]??''))delete draft.settings[key];
    else draft.settings[key]=normalized;
  }
  try{
    if(Object.keys(draft.settings).length)sessionStorage.setItem(CRFI_DRAFT_KEY,JSON.stringify(draft));
    else sessionStorage.removeItem(CRFI_DRAFT_KEY);
  }catch(_error){}
  crfiRefreshSettingsDot();
}
function crfiRestoreSettingsDraft(){
  const settings=crfiReadDraft().settings;
  const fields={IMAGE_SOURCE:'crfi-image-source',IMAGE:'crfi-image-ref',IMAGE_AUTOUPDATE:'crfi-auto-update',IMAGE_AUTOUPDATE_INTERVAL:'crfi-auto-interval',IMAGE_DRAIN_TIMEOUT:'crfi-drain-timeout'};
  for(const [key,id] of Object.entries(fields)){if(settings[key]!=null){const field=document.getElementById(id);if(field)field.value=String(settings[key]);}}
}
function crfiSyncImageConfig(){
  const remote=document.getElementById('crfi-image-source').value==='remote';
  document.querySelectorAll('.crfi-remote-field').forEach(el=>{el.hidden=!remote;});
  const on=document.getElementById('crfi-auto-update').value==='true';
  document.querySelectorAll('.crfi-auto-dependent').forEach(el=>el.classList.toggle('is-disabled',!on));
  document.getElementById('crfi-auto-interval').disabled=!on;
  document.getElementById('crfi-drain-timeout').disabled=!on;
}
function crfiSetImageSource(value){
  const input=document.getElementById('crfi-image-ref'),ref=input.value.trim();crfiSyncImageConfig();
  const settings=value==='remote'?{IMAGE_SOURCE:'remote',IMAGE:ref}:{IMAGE_SOURCE:'builtin'};
  crfiStageSettings(settings);
}
function crfiSaveImageRef(value){
  const source=document.getElementById('crfi-image-source'),ref=String(value).trim();
  const settings=source.value==='remote'?{IMAGE_SOURCE:'remote',IMAGE:ref}:{IMAGE:ref};
  crfiStageSettings(settings);
}
function crfiSetAutoUpdate(value){crfiSyncImageConfig();crfiStageSettings({IMAGE_AUTOUPDATE:String(value)});}
function crfiSaveAutoNumber(key,input,min,max){
  const value=Math.max(min,Math.min(max,Number.parseInt(input.value,10)||min));input.value=String(value);
  crfiStageSettings({[key]:String(value)});
}
function crfiResetAutoUpdate(){
  document.getElementById('crfi-auto-update').value='false';document.getElementById('crfi-auto-interval').value='1800';document.getElementById('crfi-drain-timeout').value='3600';crfiSyncImageConfig();
  crfiStageSettings({IMAGE_AUTOUPDATE:'false',IMAGE_AUTOUPDATE_INTERVAL:'1800',IMAGE_DRAIN_TIMEOUT:'3600'});
}
crfiRestoreSettingsDraft();
crfiSyncImageConfig();
function crfiRelTime(iso){
  const t=Date.parse(iso); if(isNaN(t)) return '';
  const m=Math.round((Date.now()-t)/60000);
  if(m<1) return 'just now'; if(m<60) return m+' minute'+(m===1?'':'s')+' ago';
  const h=Math.round(m/60); if(h<48) return h+' hour'+(h===1?'':'s')+' ago';
  const d=Math.round(h/24); return d+' day'+(d===1?'':'s')+' ago';
}
function crfiSize(mb){ const n=Number(mb)||0; return n>=1024?(Math.round(n/102.4)/10)+' GB':n+' MB'; }
function crfiInfo(){
  crfPost({action:'image-info'}).then(d=>{
    const ball=document.getElementById('crfi-ball'), title=document.getElementById('crfi-title'),
          sub=document.getElementById('crfi-sub'), chips=document.getElementById('crfi-chips');
    if(!d.exists){
      ball.className='crf-ball crf-ball-error';
      title.textContent='Runner Image';
      sub.textContent='Not built yet · '+(d.image||'ci-runner-farm-runner:latest')+' — save the Dockerfile and press Save + Build';
      chips.innerHTML='';
      return;
    }
    ball.className='crf-ball crf-ball-idle';
    title.textContent='Runner Image';
    sub.textContent='Built '+crfiRelTime(d.created)+' · '+d.image+' · '+d.id;
    const chip=(l,v)=>'<span class="crfi-chip">'+l+' <b>'+crfEsc(v)+'</b></span>';
    chips.innerHTML=
      chip('base',d.base||'?')+
      chip('size',crfiSize(d.size_mb))+
      chip('runners on it',d.in_use+'')+
      (d.source==='remote'?chip('image source','Remote — builds here are unused until Settings switches to Built-in'):'');
  }).catch(()=>{});
}
crfiInfo();

let crfiSaved='';
function crfiStats(v){
  const el=document.getElementById('crfi-df-stats'); if(!el) return;
  const text=String(v||''), lines=text===''?0:text.replace(/\r\n/g,'\n').replace(/\n+$/,'').split('\n').length;
  el.textContent=lines+' lines · '+text.length+' chars';
}
function crfiHighlight(src){
  const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const instruction=/^(FROM|RUN|CMD|LABEL|MAINTAINER|EXPOSE|ENV|ADD|COPY|ENTRYPOINT|VOLUME|USER|WORKDIR|ARG|ONBUILD|STOPSIGNAL|HEALTHCHECK|SHELL|AS)\b/;
  const tokens=/("[^"]*"|'[^']*'|--[a-zA-Z][\w-]*|\$\{?[A-Za-z_][\w]*\}?|&&|\\$)/g;
  return String(src).split('\n').map(line=>{
    if(/^\s*#/.test(line)) return '<span class="crfi-hl-comment">'+esc(line)+'</span>';
    let rest=line,out='',match=rest.match(instruction);
    if(match){out='<span class="crfi-hl-instruction">'+esc(match[0])+'</span>';rest=rest.slice(match[0].length);}
    let last=0,token;
    while((token=tokens.exec(rest))!==null){
      out+=esc(rest.slice(last,token.index));
      const value=token[0],kind=(value[0]==='"'||value[0]==="'")?'string':value.startsWith('--')?'flag':value[0]==='$'?'var':'op';
      out+='<span class="crfi-hl-'+kind+'">'+esc(value)+'</span>';
      last=token.index+value.length;
    }
    return out+esc(rest.slice(last));
  }).join('\n');
}
function crfiPaint(v){
  const highlight=document.getElementById('crfi-highlight');
  if(highlight) highlight.innerHTML=crfiHighlight(v);
  crfiStats(v);
}
(function(){
  const ta=document.getElementById('crf-dockerfile'),highlight=document.getElementById('crfi-highlight');
  crfiSaved=ta.value;crfiPaint(ta.value);
  ta.addEventListener('input',()=>{document.getElementById('crfi-dirty').classList.toggle('on',ta.value!==crfiSaved);crfiPaint(ta.value);crfiSyncTC();});
  ta.addEventListener('scroll',()=>{highlight.scrollTop=ta.scrollTop;highlight.scrollLeft=ta.scrollLeft;});
})();
function crfiResetDf(){
  crfPost({action:'get-default-dockerfile'}).then(d=>{
    if(!d.dockerfile) return;
    crfiSet(d.dockerfile);  // Keep highlighting, text, and the dirty marker in sync.
    document.getElementById('crf-build-status').textContent='shipped default loaded — not saved yet';
    crfiSyncTC();
  }).catch(e=>{ document.getElementById('crf-build-status').textContent='could not load default — see console'; console.error('ci-runner-farm reset:',e); });
}
// NOTE: the toolchain install blocks + their splice/idempotency logic are a
// BROWSER-ONLY convenience of the image builder — there is no engine (runner-farm.sh
// / CLI) equivalent, so they can't be composed headlessly, and the block library
// must be kept in sync with default.Dockerfile by hand.
const CRFI_TC = <?=json_encode($crfi_tc)?>;
function crfiGet(){ return document.getElementById('crf-dockerfile').value; }
function crfiSet(v){
  const ta=document.getElementById('crf-dockerfile');
  ta.value=v;
  document.getElementById('crfi-dirty').classList.toggle('on',v!==crfiSaved);
  crfiPaint(v);
}
function crfiTcRe(k){ const esc=s=>s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
  return new RegExp('\\n?'+esc('# >>> ci-runner-farm toolchain: '+k+' >>>')+'[\\s\\S]*?'+esc('# <<< ci-runner-farm toolchain: '+k+' <<<')+'\\n?','g'); }
const CRFI_LEGACY_TC={
  rust:/^RUN .*rustup\.rs.*# rust\s*$/m,
  python:/^RUN .*python3.*# python\s*$/m,
  node:/^RUN .*nodesource.*# node\/ts\s*$/m,
  android:/^RUN .*sdkmanager.*# android\s*$/m,
};
function crfiHasTC(c,k){ return c.indexOf('# >>> ci-runner-farm toolchain: '+k+' >>>')>=0||!!(CRFI_LEGACY_TC[k]&&CRFI_LEGACY_TC[k].test(c)); }
function crfiInsertTC(c,k){
  const block=CRFI_TC[k]; if(!block) return c;
  const lines=c.split('\n'); let idx=-1;
  for(let i=lines.length-1;i>=0;i--){ if(/^CMD\s/.test(lines[i])){ idx=i; break; } }
  if(idx<0) return c.replace(/\n*$/,'')+'\n\n'+block+'\n';
  lines.splice(idx,0,block); return lines.join('\n');
}
function crfiToolchain(k){
  const c=crfiGet();
  if(!crfiHasTC(c,k) && k==='android' && window.swal){
    swal({title:'Add the Android SDK?',text:'Adds JDK + the Android SDK (~3-4 GB). The first Build will be slow.',type:'warning',showCancelButton:true,confirmButtonText:'Add Android',cancelButtonText:'Cancel'},ok=>{ if(ok){ crfiSet(crfiInsertTC(crfiGet(),k)); crfiSyncTC(); } });
    return;
  }
  let next;
  if(c.indexOf('# >>> ci-runner-farm toolchain: '+k+' >>>')>=0){
    next=c.replace(crfiTcRe(k),'\n');
    if(next===c) next=crfiInsertTC(c.replace(new RegExp('# >>> ci-runner-farm toolchain: '+k+' >>>'),''),k); // closing marker was edited away — re-insert clean
  } else if(CRFI_LEGACY_TC[k]&&CRFI_LEGACY_TC[k].test(c)){
    next=c.replace(CRFI_LEGACY_TC[k],'').replace(/\n{3,}/g,'\n\n');
  } else next=crfiInsertTC(c,k);
  crfiSet(next); crfiSyncTC();
}
function crfiSyncTC(){ const c=crfiGet(); document.querySelectorAll('.crfi-tc').forEach(el=>el.classList.toggle('on', crfiHasTC(c,el.dataset.tc))); }
crfiSyncTC();
document.querySelector('.crfi-toolchains').addEventListener('keydown',e=>{ if((e.key==='Enter'||e.key===' ')&&e.target.classList.contains('crfi-tc')){ e.preventDefault(); crfiToolchain(e.target.dataset.tc); } });
function crfiBuildState(state,msg){
  const b=document.getElementById('crfi-build-ball');
  b.style.display=state?'inline-block':'none';
  b.className='crf-ball '+(state==='busy'?'crf-ball-busy':state==='ok'?'crf-ball-idle':state==='err'?'crf-ball-error':'');
  document.getElementById('crf-build-status').textContent=msg||'';
  const logState=document.getElementById('crfi-log-state');
  logState.className='crfi-log-state'+(state?' is-'+state:'');
  logState.textContent=state==='busy'?'building':state==='ok'?'success':state==='err'?'failed':'idle';
}
function crfSaveDf(cb){ crfPost({action:'save-dockerfile',dockerfile:document.getElementById('crf-dockerfile').value}).then(o=>{
  if(o.ok){ crfiSaved=document.getElementById('crf-dockerfile').value; document.getElementById('crfi-dirty').classList.remove('on');
    document.getElementById('crfi-df-path').textContent='/boot/config/plugins/ci-runner-farm/Dockerfile'; }
  crfiBuildState(o.ok?'ok':'err', o.ok?'saved':('error: '+(o.error||'')));
  if(typeof cb==='function') cb(!!o.ok,String(o.dockerfile_sha||'')); }).catch(e=>{ crfiBuildState('err','could not save Dockerfile — see console'); console.error('ci-runner-farm save-dockerfile:',e); if(typeof cb==='function') cb(false,''); }); }
function crfiCandidate(d){
  const valid=d&&typeof d.candidate_tag==='string'&&/^[-A-Za-z0-9._\/:]+$/.test(d.candidate_tag)&&typeof d.image_id==='string'&&/^sha256:[0-9a-f]{64}$/.test(d.image_id);
  window.__crfCandidate=valid?{tag:d.candidate_tag,id:d.image_id}:null;
  document.getElementById('crfi-promote').disabled=!valid;
  return valid;
}
function crfPromote(){
  const c=window.__crfCandidate; if(!c)return;
  crfiBuildState('busy','verifying + promoting candidate...');
  crfPost({action:'promote-image',candidate_tag:c.tag,image_id:c.id}).then(o=>{
    if(!o||!o.ok){crfiBuildState('err',(o&&o.error)||'promotion failed');return;}
    window.__crfCandidate=null; document.getElementById('crfi-promote').disabled=true;
    crfiBuildState('ok','candidate promoted — restart the fleet to use it'); crfiInfo();
  }).catch(e=>{crfiBuildState('err','promotion failed — see console');console.error('ci-runner-farm promote:',e);});
}
function crfBuild(){
  // Re-entrancy guard: a build (and its poll loop) is already live. Without this, a
  // second Save+Build while a build runs would save the Dockerfile (clearing the dirty
  // dot) and get an "already running" rejection — then the FIRST build's poller would
  // paint "build finished", leaving a success banner + clean editor over the OLD image.
  if(window.__crfBuilding) return;
  crfiCandidate(null); // a new attempt must not leave an older candidate promotable in the UI
  window.__crfBuilding=true; window.__crfBuildNull=0; window.__crfBuildErr=0;
  crfiBuildState('busy','saving + building...');
  crfSaveDf(function(ok,dockerfileSha){
    if(!ok){ window.__crfBuilding=false; return; }   // save failed — crfSaveDf already painted the error and kept the dirty dot
    crfPost({action:'build-image',dockerfile_sha:dockerfileSha}).then(o=>{
      if(o&&o.ok===false){ window.__crfBuilding=false; crfiBuildState('err', o.error||'could not start build'); return; }
      crfPollBuild();
    }).catch(e=>{ window.__crfBuilding=false; crfiBuildState('err','could not start build — see console'); console.error('ci-runner-farm build:',e); });
  });
}
// Keep tracking a running build when the tab is backgrounded, just poll slower — the
// NAS is busiest mid-build, so don't hammer build-log every 2s into a hidden tab.
function crfBuildNext(ms){ setTimeout(crfPollBuild, document.hidden ? Math.max(ms,8000) : ms); }
function crfPollBuild(){ crfPost({action:'build-log'}).then(d=>{ window.__crfBuildErr=0; const el=document.getElementById('crf-build-log'); el.innerHTML='<div class="crfi-log-output">'+crfColorize(d.log||'')+'</div>'; el.scrollTop=el.scrollHeight;
  if(d.running){ window.__crfBuildNull=0; crfiBuildState('busy','building...'); crfBuildNext(2000); }
  else if(d.rc===0){ window.__crfBuilding=false; if(crfiCandidate(d))crfiBuildState('ok','candidate verified — promote it to update the production tag'); else crfiBuildState('err','build finished but candidate verification metadata is missing'); crfiInfo(); }
  else if(typeof d.rc==='number'){ window.__crfBuilding=false; crfiBuildState('err','build failed (exit '+d.rc+') — see log'); crfiInfo(); }
  else if((window.__crfBuildNull=(window.__crfBuildNull||0)+1) < 3){ crfiBuildState('busy','finishing…'); crfBuildNext(1500); }
  else { window.__crfBuildNull=0; window.__crfBuilding=false; crfiBuildState('err','build status unknown (interrupted?) — see log'); crfiInfo(); } })
  .catch(e=>{ console.error('ci-runner-farm build:',e);
    // A long build issues hundreds of 2s polls under heavy NAS build load; a single
    // dropped request or transient 403 must not end the loop while the build keeps
    // running server-side. Retry a bounded number of times before giving up.
    if((window.__crfBuildErr=(window.__crfBuildErr||0)+1) < 5){ crfiBuildState('busy','reconnecting…'); crfBuildNext(3000); }
    else { window.__crfBuildErr=0; window.__crfBuilding=false; crfiBuildState('err','build status unknown — see console'); } }); }
function crfiRestoreBuild(){
  crfPost({action:'build-log'}).then(d=>{
    const el=document.getElementById('crf-build-log');
    if(d.log){el.innerHTML='<div class="crfi-log-output">'+crfColorize(d.log)+'</div>';el.scrollTop=el.scrollHeight;}
    if(d.running){window.__crfBuilding=true;window.__crfBuildNull=0;window.__crfBuildErr=0;crfiBuildState('busy','building...');crfBuildNext(2000);}
    else if(d.log&&d.rc===0){if(crfiCandidate(d))crfiBuildState('ok','candidate verified — promote it to update the production tag');else crfiBuildState('err','candidate verification metadata is missing');}
    else if(d.log&&typeof d.rc==='number')crfiBuildState('err','build failed (exit '+d.rc+') — see log');
  }).catch(e=>console.error('ci-runner-farm restore build:',e));
}
crfiRestoreBuild();
</script>
