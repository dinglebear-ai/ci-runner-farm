<?php
require_once '/usr/local/emhttp/plugins/ci-runner-farm/include/crf-frame.php';
if (!crf_begin_embedded_page('RunnerFarmImage', 'Runner Farm: Runner image')) return;
include_once '/usr/local/emhttp/plugins/ci-runner-farm/include/crf-core.php';
crf_render_shell('settings', 'image');
/* Runner image builder tab: image status band, editable highlighted Dockerfile,
   and the build pipeline.
   The crf* JS core + .crf-* styles come from include/crf-core.php (above, shared
   by all tabs via include_once). */
$crf_plugin = 'ci-runner-farm';
$crfi_cfg = parse_plugin_cfg($crf_plugin);
$crfi_image_source = $crfi_cfg['IMAGE_SOURCE'] ?? 'builtin';
$crfi_image_ref = $crfi_cfg['IMAGE'] ?? '';
$crfi_autoupdate = $crfi_cfg['IMAGE_AUTOUPDATE'] ?? 'false';
$crfi_autoupdate_interval = $crfi_cfg['IMAGE_AUTOUPDATE_INTERVAL'] ?? '1800';
$crfi_drain_timeout = $crfi_cfg['IMAGE_DRAIN_TIMEOUT'] ?? '3600';
$crfi_config_revision = trim((string)@shell_exec('/usr/local/emhttp/plugins/ci-runner-farm/include/runner-farm.sh config-revision 2>/dev/null'));
if (!preg_match('/^[0-9a-f]{64}$/', $crfi_config_revision)) $crfi_config_revision = str_repeat('0', 64);
$crf_df     = "/boot/config/plugins/$crf_plugin/Dockerfile";
$crf_df_saved = is_file($crf_df);
if (!$crf_df_saved) $crf_df = "/usr/local/emhttp/plugins/$crf_plugin/default.Dockerfile";
$crf_dockerfile = is_file($crf_df) ? file_get_contents($crf_df) : '';
$crf_df_lines = $crf_dockerfile === '' ? 0 : substr_count(rtrim($crf_dockerfile, "\r\n"), "\n") + 1;
$crf_df_chars = strlen($crf_dockerfile);

/* Toolchain install blocks the Runner image tab can splice into the Dockerfile.
   Nowdoc keeps $ and backslashes literal; delimited markers make add/remove
   idempotent and let the UI detect which are already present. */
$crfi_tc = [];
$crfi_tc['rust'] = <<<'DFBLOCK'
# >>> ci-runner-farm toolchain: rust >>>
# Rust stable, native build tools, and a verified prebuilt sccache binary.
ARG SCCACHE_VERSION=0.16.0
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/home/runner/.cargo \
    RUSTC_WRAPPER=/usr/local/bin/sccache \
    CARGO_INCREMENTAL=0 \
    SCCACHE_DIR=/home/runner/.cache/sccache \
    SCCACHE_CACHE_SIZE=10G \
    SCCACHE_IDLE_TIMEOUT=0 \
    SCCACHE_BASEDIRS=/_work \
    PATH=/home/runner/.cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential clang lld cmake pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p "$RUSTUP_HOME" "$CARGO_HOME" "$SCCACHE_DIR" \
 && curl --proto '=https' --tlsv1.2 -sSf -o /tmp/rustup-init.sh https://sh.rustup.rs \
 && sh /tmp/rustup-init.sh -y --no-modify-path --default-toolchain stable --profile minimal -c clippy,rustfmt \
 && rm -f /tmp/rustup-init.sh \
 && arch="$(dpkg --print-architecture)" \
 && case "$arch" in \
      amd64) sccache_target="x86_64-unknown-linux-musl"; sccache_sha256="aec995a83ad3dff3d14b6314e08858b7b73d35ca85a5bcf3d3a9ec07dee35588" ;; \
      arm64) sccache_target="aarch64-unknown-linux-musl"; sccache_sha256="f73a5c39f96bb6ebb89cc7915cf182260d4cbf30765322c5e793d0fe8bd80784" ;; \
      *) echo "Unsupported architecture for sccache: $arch" >&2; exit 1 ;; \
    esac \
 && sccache_archive="sccache-v$SCCACHE_VERSION-$sccache_target.tar.gz" \
 && sccache_dir="sccache-v$SCCACHE_VERSION-$sccache_target" \
 && sccache_base="https://github.com/mozilla/sccache/releases/download/v$SCCACHE_VERSION" \
 && curl -fsSL -o "/tmp/$sccache_archive" "$sccache_base/$sccache_archive" \
 && echo "$sccache_sha256  /tmp/$sccache_archive" | sha256sum -c - \
 && tar -xzf "/tmp/$sccache_archive" -C /tmp \
 && install -m 0755 "/tmp/$sccache_dir/sccache" /usr/local/bin/sccache \
 && rm -rf "/tmp/$sccache_archive" "/tmp/$sccache_dir" \
 && chown -R runner:runner "$RUSTUP_HOME" "$CARGO_HOME" "$SCCACHE_DIR"
# <<< ci-runner-farm toolchain: rust <<<
DFBLOCK;
$crfi_tc['python'] = <<<'DFBLOCK'
# >>> ci-runner-farm toolchain: python >>>
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv python3-dev pipx \
 && rm -rf /var/lib/apt/lists/*
# <<< ci-runner-farm toolchain: python <<<
DFBLOCK;
$crfi_tc['node'] = <<<'DFBLOCK'
# >>> ci-runner-farm toolchain: node >>>
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && corepack enable \
 && rm -rf /var/lib/apt/lists/*
# <<< ci-runner-farm toolchain: node <<<
DFBLOCK;
$crfi_tc['android'] = <<<'DFBLOCK'
# >>> ci-runner-farm toolchain: android >>>
# Android SDK — large (~3-4 GB); the first Build will be slow.
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p "$ANDROID_SDK_ROOT/cmdline-tools" \
 && curl -fsSL -o /tmp/actools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
 && unzip -q /tmp/actools.zip -d "$ANDROID_SDK_ROOT/cmdline-tools" \
 && mv "$ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools" "$ANDROID_SDK_ROOT/cmdline-tools/latest" \
 && rm /tmp/actools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"
# <<< ci-runner-farm toolchain: android <<<
DFBLOCK;
?>
