        <option value="builtin"<?=$crfi_image_source === 'builtin' ? ' selected' : ''?>>Built-in (build locally)</option>
        <option value="remote"<?=$crfi_image_source === 'remote' ? ' selected' : ''?>>Registry (pull)</option>
      </select>
      <label class="crfi-remote-field" for="crfi-image-ref">Image ref</label>
