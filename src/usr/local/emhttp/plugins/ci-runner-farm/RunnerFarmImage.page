      <div class="crfi-number-row crfi-auto-dependent"><input id="crfi-auto-interval" type="number" min="300" max="86400" value="<?=htmlspecialchars($crfi_autoupdate_interval, ENT_QUOTES)?>" onchange="crfiSaveAutoNumber('IMAGE_AUTOUPDATE_INTERVAL',this,300,86400)"><span>seconds</span></div>
      <label class="crfi-auto-dependent" for="crfi-drain-timeout">Drain timeout</label>
      <div class="crfi-number-row crfi-auto-dependent"><input id="crfi-drain-timeout" type="number" min="60" max="86400" value="<?=htmlspecialchars($crfi_drain_timeout, ENT_QUOTES)?>" onchange="crfiSaveAutoNumber('IMAGE_DRAIN_TIMEOUT',this,60,86400)"><span>seconds</span></div>
