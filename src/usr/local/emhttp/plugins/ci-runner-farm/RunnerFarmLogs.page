        </label>
        <button type="button" class="crf-button crf-button-compact crfl-follow is-active" id="crfl-follow" aria-pressed="true" title="Keep the newest log line in view">
          <span>follow</span>
        </button>
        <button type="button" class="crf-button crf-button-compact" id="crfl-export">
          <span>export</span>
        </button>
        <button type="button" class="crf-button crf-button-compact" id="crfl-copy">
          <span>Copy</span>
