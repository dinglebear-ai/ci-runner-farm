    </header>
    <div class="crfl-connection" id="crfl-connection" role="status" hidden></div>
    <div class="crfl-log" id="crfl-log" role="log" aria-live="polite" aria-busy="true" tabindex="0">
      <div class="crfl-empty"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"></i> Loading farm log…</div>
    </div>
  </section>
</main>

<style>
