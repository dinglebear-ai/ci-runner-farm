        <span class="crf-section-label" id="crfl-title">Farm log</span>
        <span class="crfl-meta" id="crfl-meta">Connecting…</span>
      </div>
      <div class="crfl-actions">
        <div class="crfl-levels" role="group" aria-label="Filter farm log by level">
          <button type="button" class="crf-filter-chip is-active" data-crfl-level="all" aria-pressed="true">All</button>
          <button type="button" class="crf-filter-chip crfl-chip-error" data-crfl-level="error" aria-pressed="false">Errors</button>
          <button type="button" class="crf-filter-chip crfl-chip-warning" data-crfl-level="warning" aria-pressed="false">Warnings</button>
          <button type="button" class="crf-filter-chip" data-crfl-level="info" aria-pressed="false">Info</button>
