<script>
(() => {
  'use strict';
  const state = { rows: [], poolRates: null, result: 'all', pool: 'all', query: '', limit: 8, statusPending: false, open: '', logs: new Map(), logPending: new Set() };
  const list = document.getElementById('crfh-list');
  const poolSelect = document.getElementById('crfh-pool');
  const queryInput = document.getElementById('crfh-query');
  const moreRow = document.getElementById('crfh-more-row');
  const moreButton = document.getElementById('crfh-more');
  const connection = document.getElementById('crfh-connection');

  function active() {
    const main = document.querySelector('[data-screen-label="History"]');
    return !document.hidden && !!main && main.offsetParent !== null;
  }

  function conclusion(value) {
    const normalized = String(value || 'unknown').toLowerCase();
    return ['success', 'failure', 'cancelled'].includes(normalized) ? normalized : 'unknown';
  }

  function parsedTime(value) {
    const time = Date.parse(String(value || ''));
    return Number.isNaN(time) ? null : new Date(time);
  }

  function relativeTime(value) {
    const date = parsedTime(value);
    if (!date) return '—';
    const age = Math.max(0, Date.now() - date.getTime());
    if (age < 60000) return 'now';
    if (age < 3600000) return Math.floor(age / 60000) + 'm ago';
    if (age < 86400000) return Math.floor(age / 3600000) + 'h ago';
    if (age < 604800000) return Math.floor(age / 86400000) + 'd ago';
    return date.toLocaleDateString([], { month: 'short', day: 'numeric' });
  }

  function groupLabel(value) {
    const date = parsedTime(value);
    if (!date) return 'Unknown date';
    const now = new Date();
    const startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const startDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());
    const days = Math.round((startToday - startDate) / 86400000);
    if (days === 0) return now.getHours() < 6 ? 'Tonight' : 'Today';
    if (days === 1) return 'Yesterday';
    return date.toLocaleDateString([], { weekday: 'long', month: 'short', day: 'numeric' });
  }

  function updatePoolOptions() {
    const pools = [...new Set(state.rows.map(row => String(row.pool_id || 'unknown')))].sort();
    const previous = state.pool;
    poolSelect.replaceChildren();
    const all = document.createElement('option');
    all.value = 'all';
    all.textContent = 'all pools';
    poolSelect.appendChild(all);
    pools.forEach(pool => {
      const option = document.createElement('option');
      option.value = pool;
      option.textContent = pool;
      poolSelect.appendChild(option);
    });
    state.pool = previous === 'all' || pools.includes(previous) ? previous : 'all';
    poolSelect.value = state.pool;
  }

  function filteredRows() {
    const query = state.query.trim().toLowerCase();
    return state.rows.filter(row => {
      const result = conclusion(row.conclusion);
      if (state.result !== 'all' && result !== state.result) return false;
      if (state.pool !== 'all' && String(row.pool_id || 'unknown') !== state.pool) return false;
      if (!query) return true;
      return [row.job, row.pool_id, row.runner_name].some(value => String(value || '').toLowerCase().includes(query));
    });
  }

  function appendText(parent, className, text) {
    const element = document.createElement('span');
    element.className = className;
    element.textContent = text;
    parent.appendChild(element);
    return element;
  }

  function renderRows() {
    const rows = filteredRows();
    const visible = rows.slice(0, state.limit);
    const fragment = document.createDocumentFragment();
    let lastGroup = '';

    if (!visible.length) {
      const empty = document.createElement('div');
      empty.className = 'crfh-empty';
      const icon = document.createElement('i');
      icon.className = 'fa fa-history';
      icon.setAttribute('aria-hidden', 'true');
      empty.append(icon, document.createTextNode(state.rows.length ? ' No activity matches these filters.' : ' No completed one-shot activity yet.'));
      fragment.appendChild(empty);
    } else {
      visible.forEach(activity => {
        const group = groupLabel(activity.completed_at);
        if (group !== lastGroup) {
          const heading = document.createElement('div');
          heading.className = 'crfh-day';
          heading.textContent = group;
          fragment.appendChild(heading);
          lastGroup = group;
        }

        const row = document.createElement('article');
        const historyKey=String(activity.runner_name||'')+':'+String(activity.work_handle||'');
        row.className = 'crfh-row';
        row.tabIndex=0;row.setAttribute('role','button');row.setAttribute('aria-expanded',historyKey===state.open?'true':'false');row.dataset.historyKey=historyKey;row.dataset.runnerName=String(activity.runner_name||'');

        const time = document.createElement('span');
        time.className = 'crfh-time';
        time.title = String(activity.completed_at || '');
        const date = parsedTime(activity.completed_at);
        appendText(time, 'crfh-clock', date ? date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '—');
        appendText(time, 'crfh-relative', relativeTime(activity.completed_at));
        row.appendChild(time);

        appendText(row, 'crfh-pool', String(activity.pool_id || 'unknown'));
        const job = appendText(row, 'crfh-job', String(activity.job || 'unnamed job'));
        job.title = String(activity.job || '');
        const result = conclusion(activity.conclusion);
        appendText(row, 'crfh-result crfh-result-' + result, result);
        fragment.appendChild(row);
        if(historyKey===state.open){
          const drawer=document.createElement('div');drawer.className='crfh-drawer';drawer.dataset.historyDrawer=historyKey;
          drawer.innerHTML=state.logs.get(historyKey)||'<span class="crf-muted">loading archived log…</span>';
          fragment.appendChild(drawer);
        }
      });
    }

    list.replaceChildren(fragment);
    list.setAttribute('aria-busy', 'false');
    const remaining = Math.max(0, rows.length - visible.length);
    moreRow.hidden = remaining === 0;
    moreButton.textContent = remaining ? 'Load more · ' + remaining + ' older' : 'Load more';
    renderPoolRates();
    if(state.open&&!state.logs.has(state.open))fetchHistoryLog(state.open);
  }

  function fetchHistoryLog(key){
    if(state.logPending.has(key))return;
    const activity=state.rows.find(row=>String(row.runner_name||'')+':'+String(row.work_handle||'')===key);if(!activity)return;
    state.logPending.add(key);
    crfPost({action:'history-log',name:String(activity.runner_name||'')}).then(data=>{
      state.logs.set(key,crfColorize(data.log||'(archived output unavailable)'));
      const drawer=list.querySelector('[data-history-drawer="'+CSS.escape(key)+'"]');if(drawer)drawer.innerHTML=state.logs.get(key);
    }).catch(error=>{
      state.logs.set(key,'<span class="crf-muted">Archived log unavailable: '+crfEsc(error.message)+'</span>');
      const drawer=list.querySelector('[data-history-drawer="'+CSS.escape(key)+'"]');if(drawer)drawer.innerHTML=state.logs.get(key);
    }).finally(()=>state.logPending.delete(key));
  }

  function renderPoolRates() {
    const target = document.getElementById('crfh-pool-rates');
    const totals = new Map();
    if(state.poolRates){
      Object.entries(state.poolRates).forEach(([pool,percent])=>totals.set(pool,{success:Number(percent)||0,total:100}));
    }else{
      state.rows.forEach(row => {
        const result = conclusion(row.conclusion);
        if (result !== 'success' && result !== 'failure') return;
        const pool = String(row.pool_id || 'unknown');
        const current = totals.get(pool) || { success: 0, total: 0 };
        current.total += 1;
        if (result === 'success') current.success += 1;
        totals.set(pool, current);
      });
    }

    const fragment = document.createDocumentFragment();
    const order=['rust','python','typescript','go','ops','system'];
    [...totals.entries()].sort((a,b)=>{const ai=order.indexOf(a[0]),bi=order.indexOf(b[0]);return (ai<0?999:ai)-(bi<0?999:bi)||a[0].localeCompare(b[0]);}).forEach(([pool, counts]) => {
      const percent = counts.total ? Math.round(100 * counts.success / counts.total) : 0;
      const row = document.createElement('div');
      row.className = 'crfh-pool-rate';
      appendText(row, 'crfh-pool-name', pool);
      const bar = document.createElement('span');
      bar.className = 'crfh-pool-bar';
      const fill = document.createElement('span');
      fill.style.width = percent + '%';
      if (percent < 55) fill.style.background = 'var(--crf-err)';
      else if (percent < 85) fill.style.background = '#e9bf41';
      bar.appendChild(fill);
      row.appendChild(bar);
      appendText(row, 'crfh-pool-pct', percent + '%');
      fragment.appendChild(row);
    });
    target.replaceChildren(fragment);
    target.hidden = totals.size === 0;
  }

  function showConnection(message) {
    connection.textContent = message;
    connection.hidden = !message;
  }

  function refreshStatus() {
    if (!active() || state.statusPending) return;
    state.statusPending = true;
    crfPost({ action: 'status-json' }).then(data => {
      if (!data || data.schema_version !== 2 || !Array.isArray(data.recent_activity)) {
        throw new Error('unsupported or malformed history snapshot');
      }
      state.rows = data.recent_activity.slice().sort((a, b) => {
        const left = parsedTime(a.completed_at);
        const right = parsedTime(b.completed_at);
        return (right ? right.getTime() : 0) - (left ? left.getTime() : 0);
      });
      updatePoolOptions();
      showConnection('');
      renderRows();
    }).catch(error => {
      showConnection('History connection lost — retrying…');
      console.error('ci-runner-farm history:', error);
      if (!state.rows.length) renderRows();
    }).finally(() => { state.statusPending = false; });
  }

  function setStat(id, value) {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  }

  function refreshStats() {
    if (!active()) return;
    crfPost({ action: 'stats-json' }).then(data => {
      const available = data && Number.isInteger(data.total) && data.total >= 0;
      if (!available) throw new Error('run statistics unavailable');
      const passed = Number.isInteger(data.ok) ? data.ok : 0;
      const failed = Number.isInteger(data.fail) ? data.fail : 0;
      const cancelled = Number.isInteger(data.cancel) ? data.cancel : 0;
      const settled = passed + failed + cancelled;
      const rate = settled ? Math.round(100 * passed / settled) + '%' : '–';
      setStat('crfh-passed', String(passed));
      setStat('crfh-failed', String(failed));
      setStat('crfh-cancelled', String(cancelled));
      setStat('crfh-total', String(data.total));
      setStat('crfh-rate', rate);
      const denominator=Math.max(1,settled);
      document.getElementById('crfh-bar-passed').style.width=(100*passed/denominator)+'%';
      document.getElementById('crfh-bar-failed').style.width=(100*failed/denominator)+'%';
      document.getElementById('crfh-bar-cancelled').style.width=(100*cancelled/denominator)+'%';
      state.poolRates=data.pool_rates&&typeof data.pool_rates==='object'?data.pool_rates:null;
      renderPoolRates();
    }).catch(error => {
      ['crfh-passed', 'crfh-failed', 'crfh-cancelled', 'crfh-total'].forEach(id => setStat(id, '–'));
      setStat('crfh-rate', '–');
      console.warn('ci-runner-farm run statistics:', error);
    });
  }

  document.querySelectorAll('[data-crfh-result]').forEach(button => {
    button.addEventListener('click', () => {
      state.result = button.dataset.crfhResult || 'all';
      state.limit = 8;
      document.querySelectorAll('[data-crfh-result]').forEach(candidate => {
        const selected = candidate === button;
        candidate.classList.toggle('is-active', selected);
        candidate.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      renderRows();
    });
  });

  poolSelect.addEventListener('change', () => { state.pool = poolSelect.value; state.limit = 8; renderRows(); });
  queryInput.addEventListener('input', () => { state.query = queryInput.value; state.limit = 8; renderRows(); });
  moreButton.addEventListener('click', () => { state.limit += 8; renderRows(); });
  list.addEventListener('click',event=>{const row=event.target.closest('.crfh-row[data-history-key]');if(!row)return;state.open=state.open===row.dataset.historyKey?'':row.dataset.historyKey;renderRows();});
  list.addEventListener('keydown',event=>{if(event.key!=='Enter'&&event.key!==' ')return;const row=event.target.closest('.crfh-row[data-history-key]');if(!row)return;event.preventDefault();state.open=state.open===row.dataset.historyKey?'':row.dataset.historyKey;renderRows();});
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { refreshStatus(); refreshStats(); } });

  refreshStatus();
  refreshStats();
  window.setInterval(refreshStatus, 10000);
  window.setInterval(refreshStats, 60000);
})();
</script>
