(function(){
  const min=document.getElementsByName('AUTOSCALE_MIN')[0],max=document.getElementsByName('AUTOSCALE_MAX')[0];
  const warning=document.createElement('div');warning.className='crfp-inline-warning';
  warning.textContent='Single fleet minimum exceeds maximum; the runtime will clamp it.';
  document.getElementById('crfp-advanced').appendChild(warning);
  const check=()=>warning.classList.toggle('on',+min.value>+max.value);
  min.addEventListener('input',check);max.addEventListener('input',check);check();
})();
(function(){
  const host=<?=json_encode($host_mem_gb)?>,memory=document.getElementsByName('RUNNER_MEMORY')[0];
  if(!host||!memory)return;
  const warning=document.createElement('div');warning.className='crfp-inline-warning';
  document.getElementById('crfp-advanced').appendChild(warning);
  const toGiB=value=>{const bytes=crfPoolMemoryBytes(value);return bytes===null?0:Number(bytes)/1073741824;};
  const check=()=>{const records=crfPoolRows(),auto=document.getElementsByName('AUTOSCALE')[0].value==='true';
    let count=0,total=0;
    if(document.getElementById('crf-runner-mode').value==='pools'){
      records.forEach(row=>{const target=+(crfPoolInput(row,row.dataset.capacityMode==='auto'?'min':'fixed').value)||0;
        const value=crfPoolValue(row,'memory'),gb=toGiB(value==='inherit'?memory.value:value);count+=target;total+=target*gb;});
    }else{
      count=+(document.getElementsByName(auto?'AUTOSCALE_MIN':'RUNNER_COUNT')[0].value||0);total=count*toGiB(memory.value);
    }
    warning.textContent='Warm floor '+count+' runners reserve about '+total.toFixed(1)+'g of '+host+'g host memory.';
    warning.classList.toggle('on',total>host*.8);
  };
  document.addEventListener('crf-pools-change',check);memory.addEventListener('input',check);check();
})();

const crfPoolsForm=document.forms['ci_runner_pools'];
crfPoolsForm.addEventListener('submit',event=>{event.preventDefault();if(crfPoolsForm.dataset.applying!=='1')crfOpenPoolReview();});
async function crfConfirmPoolApply(){
  if(crfPoolsForm.dataset.applying==='1'||!crfValidatePools(true))return;
  const settings=crfPoolSnapshotData();
  const submit=crfPoolsForm.querySelector('input[type=submit]'),result=document.getElementById('crf-pools-result');
  const confirm=document.getElementById('crfp-confirm-apply');crfPoolsForm.dataset.applying='1';submit.disabled=true;confirm.disabled=true;
  try{
    const validated=await crfPost({action:'validate-pools',mode:settings.RUNNER_MODE,pools:settings.RUNNER_POOLS,scope:CRF_POOL_SCOPE,owner:CRF_POOL_OWNER,pool_autoscale:settings.POOL_AUTOSCALE,backend:settings.POOL_BACKEND,runner_cpus:settings.RUNNER_CPUS,runner_memory:settings.RUNNER_MEMORY});
    if(!validated.ok)throw new Error(validated.error||'Pool validation failed');
    const applied=await crfPost({action:'apply-config',expected_config_revision:CRF_POOL_CONFIG_REVISION,settings:JSON.stringify(settings)});
    if(!applied.ok)throw new Error(applied.error||'Apply failed');
    CRF_POOL_CONFIG_REVISION=applied.config_revision;
    crfBuildPoolEditor(settings.RUNNER_POOLS,settings.POOL_AUTOSCALE);crfClosePoolReview();CRF_POOL_BASELINE=crfPoolSnapshot();crfSetPoolDirty();
    result.textContent='Pool settings saved. Use Fleet migration controls to activate a requested backend change.';
    result.className='crfp-result on saved';crfToast('Pool settings saved');
  }catch(error){result.textContent='Could not save pool settings: '+error.message;result.className='crfp-result on';}
  finally{delete crfPoolsForm.dataset.applying;submit.disabled=false;confirm.disabled=false;}
}
