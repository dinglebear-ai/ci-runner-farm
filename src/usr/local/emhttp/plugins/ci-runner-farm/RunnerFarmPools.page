let CRF_COMPAT_OPERATION='',CRF_COMPAT_FAILURES=0,CRF_COMPAT_TIMER=null;
function crfPoolsActive(){
  const box=document.getElementById('crf-scaleset-readiness');
  return !document.hidden&&!!box&&box.offsetParent!==null;
}
function crfScheduleCompatibility(delay){
  if(CRF_COMPAT_TIMER)clearTimeout(CRF_COMPAT_TIMER);
  CRF_COMPAT_TIMER=setTimeout(()=>{
    CRF_COMPAT_TIMER=null;
    if(!CRF_COMPAT_OPERATION)return;
    if(!crfPoolsActive()){crfScheduleCompatibility(Math.min(12000,Math.max(1500,delay*2)));return;}
    crfPollCompatibility();
  },delay);
}
function crfFinishCompatibility(message){
  if(CRF_COMPAT_TIMER)clearTimeout(CRF_COMPAT_TIMER);
  CRF_COMPAT_TIMER=null;CRF_COMPAT_OPERATION='';CRF_COMPAT_FAILURES=0;
  document.getElementById('crf-compat-run').removeAttribute('aria-busy');
  if(message)document.getElementById('crf-scaleset-readiness').textContent=message;
}
function crfRenderReadiness(d){
  const box=document.getElementById('crf-scaleset-readiness'),c=d.compatibility||{},b=d.backend||{};
  const identity=[c.helper_digest&&('helper '+c.helper_digest.slice(0,12)),c.plugin_digest&&('plugin '+c.plugin_digest.slice(0,12)),
    c.runner_group_id!=null&&('production group '+c.runner_group_id),
    c.quarantine_runner_group_id!=null&&('quarantine group '+c.quarantine_runner_group_id)].filter(Boolean).join(' · ');
  box.textContent='Requested '+(b.requested||'unknown')+' · effective '+(b.effective||'unknown')+' · '+(b.transition_phase||'unknown')+
    ' · gate '+(c.valid?'valid':(c.reason||'not ready'))+(identity?' · '+identity:'');
}
function crfRefreshReadiness(){crfPost({action:'readiness-json'}).then(crfRenderReadiness).catch(()=>{});}
function crfPollCompatibility(){
  if(!CRF_COMPAT_OPERATION)return;
  if(!crfPoolsActive()){crfScheduleCompatibility(1500);return;}
  crfPost({action:'operation-status',operation_id:CRF_COMPAT_OPERATION}).then(status=>{
    CRF_COMPAT_FAILURES=0;
    const box=document.getElementById('crf-scaleset-readiness');
    box.textContent='Compatibility test: '+status.state+(status.message?' · '+status.message:'');
    if(status.state==='running')crfScheduleCompatibility(1000);
    else{crfFinishCompatibility();crfRefreshReadiness();}
  }).catch(error=>{
    CRF_COMPAT_FAILURES++;
    if(CRF_COMPAT_FAILURES>=8){
      crfFinishCompatibility('Compatibility status could not be read after 8 attempts. Retry the test when the connection is stable.');
      console.error(error);return;
    }
    crfScheduleCompatibility(Math.min(12000,1500*(2**(CRF_COMPAT_FAILURES-1))));
  });
}
function crfRunCompatibility(){
  if(CRF_COMPAT_OPERATION)return;
  const button=document.getElementById('crf-compat-run');button.setAttribute('aria-busy','true');
  crfPost({action:'compatibility-test'}).then(result=>{
    if(!result.operation_id)throw new Error('missing operation ID');
    CRF_COMPAT_OPERATION=result.operation_id;CRF_COMPAT_FAILURES=0;crfPollCompatibility();
  }).catch(error=>{button.removeAttribute('aria-busy');crfToast('Compatibility test could not start');console.error(error);});
}
crfRefreshReadiness();
document.addEventListener('visibilitychange',()=>{
  if(!document.hidden&&CRF_COMPAT_OPERATION)crfScheduleCompatibility(0);
});
document.getElementById('tab2')&&document.getElementById('tab2').addEventListener('click',()=>{
