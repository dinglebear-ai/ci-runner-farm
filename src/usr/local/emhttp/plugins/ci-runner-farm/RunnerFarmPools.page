<script>
const CRF_POOL_DEFAULTS=<?=json_encode($defaults)?>;
const CRF_POOL_CONFIG_KEYS=Object.freeze(Object.keys(CRF_POOL_DEFAULTS));
const CRF_POOL_SCOPE=<?=json_encode($gh_scope)?>;
const CRF_POOL_OWNER=<?=json_encode($gh_owner)?>;
const CRF_POOL_HOST_CPUS=<?=json_encode($host_cpus)?>;
let CRF_POOL_CONFIG_REVISION=<?=json_encode($config_revision)?>;
const CRF_POOL_ID=/^[a-z](?:[a-z0-9-]{0,22}[a-z0-9])?$/;
const CRF_POOL_LABEL=/^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$/;
const CRF_POOL_ROUTING_RESERVED=new Set(['self-hosted','linux','windows','macos','x64','x86','arm','arm64','default','invalid','ci-runner-farm']);
const CRF_POOL_FIELDS=Object.freeze(['id','routing_label','additional_labels','fixed','min','max','idle','cpus','memory']);
const CRF_POOL_TITLES={id:'Pool ID',routing_label:'Routing label',additional_labels:'Additional labels',fixed:'Fixed',min:'Min',max:'Max',idle:'Idle',cpus:'CPUs',memory:'Memory'};
const CRF_POOL_DRAFT_KEY='ci-runner-farm:pools-draft:v1';
const CRF_POOL_AUTOSCALE_INITIAL=document.getElementById('crf-pool-autoscale-value').value;
let CRF_POOL_ROW_SEQ=0;
let CRF_POOL_BASELINE='';
let CRF_POOL_DRAG_ROW=null;
function crfPoolRows(){return [...document.querySelectorAll('#crf-pools-editor .crfp-pool-row')];}
function crfPoolInput(row,field){return row.querySelector('[data-pool-field="'+field+'"]');}
function crfPoolRoutingReserved(label){return CRF_POOL_ROUTING_RESERVED.has(label);}
function crfPoolAdditionalReserved(label){return crfPoolRoutingReserved(label)||label.startsWith('ci-pool-');}
function crfPoolCpuMilli(value){
  value=String(value).trim().toLowerCase();
  if(value==='inherit')return null;
  const match=value.match(/^(0|[1-9][0-9]*)(?:\.([0-9]{1,3}))?$/);if(!match)return NaN;
  const milli=Number(match[1])*1000+Number((match[2]||'').padEnd(3,'0'));
  return Number.isSafeInteger(milli)&&milli>0&&milli<=256000?milli:NaN;
}
function crfPoolMemoryBytes(value){
  value=String(value).toLowerCase().replace(/\s+/g,'');
  if(value==='inherit')return null;
  const match=value.match(/^([1-9][0-9]*)(b|k|kb|ki|kib|m|mb|mi|mib|g|gb|gi|gib|t|tb|ti|tib)?$/);if(!match)return null;
  const powers={b:1n,k:1024n,kb:1024n,ki:1024n,kib:1024n,m:1048576n,mb:1048576n,mi:1048576n,mib:1048576n,g:1073741824n,gb:1073741824n,gi:1073741824n,gib:1073741824n,t:1099511627776n,tb:1099511627776n,ti:1099511627776n,tib:1099511627776n};
  try{const bytes=BigInt(match[1])*(powers[match[2]||'b']||1n);return bytes>=6291456n&&bytes<=1099511627776n?bytes:null;}catch(_error){return null;}
}
function crfPoolValue(row,field){
  let value=crfPoolInput(row,field).value.trim();
  if(['id','routing_label','additional_labels','cpus'].includes(field))value=value.toLowerCase();
  return ['cpus','memory'].includes(field)&&!value?'inherit':value;
}
function crfSerializePools(){
  const value=crfPoolRows().map(row=>'v2|'+CRF_POOL_FIELDS.map(field=>crfPoolValue(row,field)).join('|')).join(';');
  document.getElementById('crf-pools-value').value=value;
  crfSyncPoolAutoscale();
  return value;
}
function crfPoolAutoscaleIds(){return crfPoolRows().filter(row=>row.dataset.capacityMode==='auto').map(row=>crfPoolInput(row,'id').value.trim().toLowerCase()).filter(Boolean);}
function crfSyncPoolAutoscale(){
  const ids=crfPoolAutoscaleIds();
  document.getElementById('crf-pool-autoscale-value').value=ids.join(',');
  if(document.getElementById('crf-runner-mode').value==='pools'){
    // Scale sets need the daemon even when every pool has a fixed policy: it
    // renews capacity leases and turns acquired work handles into JIT runners.
    // AUTOSCALE remains that daemon master; POOL_AUTOSCALE selects policy.
    const scaleSet=document.getElementById('crf-pool-backend').value==='scaleset';
    document.getElementById('crf-autoscale-mode').value=(ids.length||scaleSet)?'true':'false';
  }
  return ids;
}
function crfPoolInitialMode(id,source=CRF_POOL_AUTOSCALE_INITIAL){
  if(source==='inherit')return document.getElementById('crf-autoscale-mode').value==='true'?'auto':'fixed';
  return (','+source+',').includes(','+String(id).toLowerCase()+',')?'auto':'fixed';
}
function crfPoolCapacity(){
  const budget=document.getElementsByName('RESOURCE_CPU_BUDGET')[0].value.trim().toLowerCase();
  const reserve=Number(document.getElementsByName('RESOURCE_CPU_RESERVE')[0].value)||0;
  const overcommit=Number(document.getElementsByName('RESOURCE_CPU_OVERCOMMIT')[0].value)||1;
  return Math.max(1,Math.round(((budget==='auto'?CRF_POOL_HOST_CPUS:Number(budget)||CRF_POOL_HOST_CPUS)-reserve)*overcommit));
}
function crfPoolCpu(row){
  const value=crfPoolValue(row,'cpus');
  const milli=crfPoolCpuMilli(value==='inherit'?(document.getElementsByName('RUNNER_CPUS')[0].value||'1'):value);
  return Number.isFinite(milli)?milli/1000:0;
}
function crfPoolTarget(row){
  const auto=row.dataset.capacityMode==='auto';
  return Number(crfPoolInput(row,auto?'min':'fixed').value)||0;
}
function crfPoolMemoryLabel(row){
  const value=crfPoolValue(row,'memory');
  return value==='inherit'?(document.getElementsByName('RUNNER_MEMORY')[0].value||'default'):value;
}
function crfUpdatePoolOverview(){
  const rows=crfPoolRows(),capacity=crfPoolCapacity();
  const committed=rows.reduce((sum,row)=>sum+crfPoolTarget(row)*crfPoolCpu(row),0);
  document.getElementById('crfp-committed-value').textContent=committed+' / '+capacity+' cores';
  document.getElementById('crfp-committed-bar').style.width=Math.min(100,Math.round(committed*100/capacity))+'%';
  rows.forEach(row=>{
    const used=crfPoolTarget(row)*crfPoolCpu(row),text=row.querySelector('.crfp-pool-meter-text');
    row.querySelector('.crfp-pool-meter-fill').style.width=Math.min(100,Math.round(used*100/capacity))+'%';
    text.textContent=used+' of '+capacity+' cores';
  });
}
function crfPoolPreview(row){
  const id=crfPoolInput(row,'id').value.trim(), routing=crfPoolInput(row,'routing_label').value.trim();
  const selector=CRF_POOL_ID.test(id)&&routing?'runs-on: '+routing:'';
  const copy=row.querySelector('.crfp-pool-selector');
  copy.disabled=!selector;copy.dataset.copy=selector;
  row.querySelector('legend').textContent='Runner pool '+(id||row.dataset.rowNumber);
  row.dataset.pool=id;
  row.querySelector('.crfp-grip').setAttribute('aria-label','Reorder '+(id||'new')+' pool');
  row.querySelector('.crfp-pool-title').textContent=id||'New pool';
  const sourceIcon=row.querySelector('.crfp-pool-icon');
  if(['rust','python','typescript','go'].includes(id))sourceIcon.innerHTML='<img src="/plugins/ci-runner-farm/assets/icons/pool-'+id+'.svg" alt="">';
  else sourceIcon.innerHTML='<i class="fa '+(id==='ops'?'fa-terminal':'fa-server')+'" aria-hidden="true"></i>';
  const auto=row.dataset.capacityMode==='auto';
  row.querySelector('.crfp-pool-badge').innerHTML='<i class="fa fa-lock" aria-hidden="true"></i> '+(auto?'autoscale':'fixed');
  row.querySelector('.crfp-mode-fixed').classList.toggle('is-active',!auto);
  row.querySelector('.crfp-mode-auto').classList.toggle('is-active',auto);
  row.querySelector('.crfp-fixed-controls').hidden=auto;
  row.querySelector('.crfp-auto-controls').hidden=!auto;
  const target=crfPoolTarget(row),cpu=crfPoolCpu(row),cpuLabel=cpu||'default',memory=crfPoolMemoryLabel(row);
  const labels=crfPoolInput(row,'additional_labels').value.trim();
  row.querySelector('.crfp-pool-summary').textContent=target+' runner'+(target===1?'':'s')+' · '+cpuLabel+' CPU · '+memory+(labels?' · +'+labels:'');
  crfUpdatePoolOverview();
}
function crfRefreshPoolPresentation(){crfPoolRows().forEach(crfPoolPreview);}
function crfSetCapacityMode(row,auto){
  row.dataset.capacityMode=auto?'auto':'fixed';
  crfSyncPoolAutoscale();crfPoolPreview(row);crfValidatePools(false);
}
function crfAddPool(rec='',notify=true,saved=false,capacityMode=''){
  const original=String(rec).split('|'), v2=original[0]==='v2';
  const defaultMax=document.getElementById('crf-pool-backend').value==='scaleset'?'auto':'16';
  const parts=v2?original.slice(1):rec?[original[0],'ci-pool-'+original[0],'',original[1],original[2],original[3],original[4],'inherit','inherit']:
    ['pool','','','1','1',defaultMax,'1','inherit','inherit'];
  while(parts.length<CRF_POOL_FIELDS.length)parts.push('');
  const row=document.createElement('fieldset');row.className='crfp-pool-row';
  row.dataset.rowNumber=String(++CRF_POOL_ROW_SEQ);
  row.dataset.capacityMode=capacityMode||crfPoolInitialMode(parts[0]);
  row.innerHTML='<legend class="crfp-sr-only"></legend>'+
    '<div class="crfp-pool-head"><span class="crfp-grip"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></span>'+
      '<span class="crfp-pool-icon" aria-hidden="true"><img alt=""></span>'+
      '<div class="crfp-pool-heading"><div><strong class="crfp-pool-title"></strong><span class="crfp-pool-badge"></span></div><span class="crfp-pool-summary"></span></div>'+
      '<button type="button" class="crfp-pool-action crfp-duplicate" title="Duplicate as new pool" aria-label="Duplicate as new pool"><i class="fa fa-clone" aria-hidden="true"></i></button>'+
      '<button type="button" class="crfp-pool-action crfp-remove" title="Remove pool" aria-label="Remove pool"><i class="fa fa-trash-o" aria-hidden="true"></i></button></div>'+
    '<div class="crfp-pool-body"><div class="crfp-identity">'+
      '<label><span>Pool ID</span><span data-slot="id"></span></label><label><span>Additional labels</span><span data-slot="additional_labels"></span></label></div>'+
      '<section class="crfp-capacity"><h3><i class="fa fa-bar-chart" aria-hidden="true"></i> Capacity</h3><div class="crfp-capacity-controls">'+
        '<span class="crfp-mode"><button type="button" class="crfp-mode-fixed">Fixed</button><button type="button" class="crfp-mode-auto">Autoscale</button></span>'+
        '<label class="crfp-fixed-controls">runners <span data-slot="fixed"></span></label>'+
        '<span class="crfp-auto-controls"><label>min <span data-slot="min"></span></label><label>max <span data-slot="max"></span></label></span>'+
        '<label>idle <span data-slot="idle"></span></label></div></section>'+
      '<section class="crfp-resources"><h3><i class="fa fa-cog" aria-hidden="true"></i> Per-runner resources <small>blank = default</small></h3><div><label>CPUs <span data-slot="cpus"></span></label><label>memory <span data-slot="memory"></span></label></div></section></div>'+
    '<div class="crfp-pool-meter"><span><span class="crfp-pool-meter-fill"></span></span><small class="crfp-pool-meter-text"></small></div>'+
    '<footer class="crfp-selector-row"><i class="fa fa-code" aria-hidden="true"></i><span>runs-on:</span><span data-slot="routing_label"></span>'+
      '<button type="button" class="crfp-pool-selector" aria-label="Copy selector"><i class="fa fa-copy" aria-hidden="true"></i> Copy</button></footer>';
  CRF_POOL_FIELDS.forEach((field,index)=>{
    const input=document.createElement('input');
    input.value=['cpus','memory'].includes(field)&&parts[index]==='inherit'?'':parts[index];input.dataset.poolField=field;
    input.type=['fixed','min','idle'].includes(field)?'number':'text';
    if(['fixed','min','idle'].includes(field)){input.min=field==='fixed'?'1':'0';input.max='64';}
    if(field==='id'&&saved) input.readOnly=true;
    if(field==='additional_labels')input.placeholder='none';
    if(field==='cpus')input.placeholder=document.getElementsByName('RUNNER_CPUS')[0].value||'default';
    if(field==='memory')input.placeholder=document.getElementsByName('RUNNER_MEMORY')[0].value||'default';
    input.setAttribute('aria-label',CRF_POOL_TITLES[field]+' for runner pool row '+row.dataset.rowNumber);
    input.addEventListener('input',()=>{crfPoolPreview(row);crfValidatePools(false);});
    row.querySelector('[data-slot="'+field+'"]').appendChild(input);
  });
  const selector=row.querySelector('.crfp-pool-selector');
  selector.addEventListener('click',()=>{if(selector.dataset.copy)crfCopyText(selector.dataset.copy).then(()=>crfToast('Selector copied'));});
  row.querySelector('.crfp-mode-fixed').addEventListener('click',()=>crfSetCapacityMode(row,false));
  row.querySelector('.crfp-mode-auto').addEventListener('click',()=>crfSetCapacityMode(row,true));
  const duplicate=row.querySelector('.crfp-duplicate');
  duplicate.addEventListener('click',()=>{
    const values=CRF_POOL_FIELDS.map(field=>crfPoolValue(row,field));
    values[0]+='-copy';values[1]+='-copy';crfAddPool('v2|'+values.join('|'),true,false,row.dataset.capacityMode);
  });
  row.querySelector('.crfp-remove').addEventListener('click',()=>{row.remove();crfValidatePools(false);});
  const grip=row.querySelector('.crfp-grip');
  grip.setAttribute('role','button');grip.tabIndex=0;
  grip.addEventListener('pointerdown',()=>{row.draggable=true;});
  grip.addEventListener('keydown',event=>{
    if(!['ArrowUp','ArrowDown'].includes(event.key))return;
    event.preventDefault();const sibling=event.key==='ArrowUp'?row.previousElementSibling:row.nextElementSibling;
    if(!sibling)return;
    if(event.key==='ArrowUp')row.parentNode.insertBefore(row,sibling);else row.parentNode.insertBefore(sibling,row);
    crfValidatePools(false);grip.focus();
  });
  row.addEventListener('dragstart',event=>{if(!row.draggable){event.preventDefault();return;}CRF_POOL_DRAG_ROW=row;event.dataTransfer.effectAllowed='move';row.classList.add('is-dragging');});
  row.addEventListener('dragover',event=>{if(CRF_POOL_DRAG_ROW&&CRF_POOL_DRAG_ROW!==row){event.preventDefault();event.dataTransfer.dropEffect='move';}});
  row.addEventListener('drop',event=>{event.preventDefault();if(!CRF_POOL_DRAG_ROW||CRF_POOL_DRAG_ROW===row)return;const rect=row.getBoundingClientRect();row.parentNode.insertBefore(CRF_POOL_DRAG_ROW,event.clientY<rect.top+rect.height/2?row:row.nextSibling);crfValidatePools(false);});
  row.addEventListener('dragend',()=>{row.draggable=false;row.classList.remove('is-dragging');CRF_POOL_DRAG_ROW=null;});
  document.getElementById('crf-pools-editor').appendChild(row);crfPoolPreview(row);
  if(notify)crfValidatePools(false);
}
function crfBuildPoolEditor(raw,autoscaleSource=CRF_POOL_AUTOSCALE_INITIAL){
  const editor=document.getElementById('crf-pools-editor');editor.textContent='';CRF_POOL_ROW_SEQ=0;
  String(raw||'').split(';').filter(Boolean).forEach(rec=>{
    const pieces=rec.split('|'),id=pieces[0]==='v2'?pieces[1]:pieces[0];
    crfAddPool(rec,false,true,crfPoolInitialMode(id,autoscaleSource));
  });
}
function crfValidatePools(focus=true){
  const mode=document.getElementById('crf-runner-mode').value,backend=document.getElementById('crf-pool-backend').value,rows=crfPoolRows();
  const result=document.getElementById('crf-pools-errors'),errors=[],seenIds=new Set(),routeCounts=new Map();
  let firstBad=null;
  rows.forEach(row=>{
    row.querySelectorAll('input').forEach(input=>{input.classList.remove('crfp-invalid');input.removeAttribute('aria-invalid');});
    const route=crfPoolValue(row,'routing_label');if(route)routeCounts.set(route,(routeCounts.get(route)||0)+1);
  });
  const routes=new Set(routeCounts.keys());
  const bad=(input,message)=>{errors.push(message);input.classList.add('crfp-invalid');input.setAttribute('aria-invalid','true');firstBad=firstBad||input;};
  if(mode==='pools'&&CRF_POOL_SCOPE!=='org')errors.push('Runner pools require Organization scope; change it under Settings.');
  if(mode==='pools'&&!/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$/.test(CRF_POOL_OWNER))errors.push('The configured organization owner is invalid.');
  if(mode==='pools'&&!rows.length)errors.push('Add at least one pool.');
  if(rows.length>8)errors.push('At most eight pools are supported.');
  rows.forEach((row,index)=>{
    const input=Object.fromEntries(CRF_POOL_FIELDS.map(field=>[field,crfPoolInput(row,field)]));
    const id=crfPoolValue(row,'id'),route=crfPoolValue(row,'routing_label');
    if(!CRF_POOL_ID.test(id)||['default','invalid'].includes(id))bad(input.id,'Pool '+(index+1)+' has an invalid or reserved ID.');
    if(seenIds.has(id))bad(input.id,'Pool ID '+id+' is duplicated.');seenIds.add(id);
    if(!CRF_POOL_LABEL.test(route)||crfPoolRoutingReserved(route))bad(input.routing_label,'Routing label for '+id+' is invalid or reserved.');
    else if((routeCounts.get(route)||0)>1)bad(input.routing_label,'Routing label '+route+' is duplicated.');
    const rawLabels=crfPoolValue(row,'additional_labels'),labels=rawLabels?rawLabels.split(','):[],labelSeen=new Set();
    if(labels.some(label=>{const duplicate=labelSeen.has(label);labelSeen.add(label);return !label||!CRF_POOL_LABEL.test(label)||crfPoolAdditionalReserved(label)||duplicate||routes.has(label);})){
      bad(input.additional_labels,'Additional labels for '+id+' are invalid, reserved, duplicated, or collide with a routing label.');
    }
    labels.forEach(label=>labelSeen.add(label));
    const fixed=input.fixed.value,min=input.min.value,max=input.max.value.trim().toLowerCase(),idle=input.idle.value;
    if(!/^[1-9][0-9]?$/.test(fixed)||+fixed>64)bad(input.fixed,'Fixed for '+id+' must be 1-64.');
    if(!/^(?:0|[1-9][0-9]?)$/.test(min)||+min>64)bad(input.min,'Min for '+id+' must be 0-64.');
    if(max!=='auto'&&(!/^[1-9][0-9]?$/.test(max)||+max>64))bad(input.max,'Max for '+id+' must be 1-64 or auto.');
    if(!/^(?:0|[1-9][0-9]?)$/.test(idle)||+idle>64)bad(input.idle,'Idle for '+id+' must be 0-64.');
    if(backend==='classic'&&+min<1)bad(input.min,'Classic pool '+id+' must keep at least one runner.');
    if(backend==='classic'&&max==='auto')bad(input.max,'Classic pool '+id+' requires a numeric maximum.');
    if(max!=='auto'&&(+min>+max||+idle>+max))bad(input.max,'Min and Idle cannot exceed Max for '+id+'.');
    const cpus=crfPoolValue(row,'cpus'),memory=crfPoolValue(row,'memory');
    const effectiveCpu=cpus==='inherit'?(document.getElementsByName('RUNNER_CPUS')[0].value||'1'):cpus;
    const effectiveMemory=memory==='inherit'?(document.getElementsByName('RUNNER_MEMORY')[0].value||'16g'):memory;
    if(!Number.isFinite(crfPoolCpuMilli(effectiveCpu)))bad(input.cpus,'CPUs for '+id+' must resolve to 0.001-256 with at most three decimals.');
    if(crfPoolMemoryBytes(effectiveMemory)===null)bad(input.memory,'Memory for '+id+' must resolve to 6 MiB-1 TiB.');
  });
  crfSerializePools();crfRefreshPoolPresentation();result.textContent=errors.join(' ');result.classList.toggle('on',errors.length>0);
  document.dispatchEvent(new Event('crf-pools-change'));
  if(errors.length&&focus&&firstBad)firstBad.focus();
  return errors.length===0;
}
function crfPoolMode(){
  const pools=document.getElementById('crf-runner-mode').value==='pools';
  document.getElementById('crfp-pool-grid').style.display=pools?'grid':'none';
  document.getElementById('crf-pools-editor').style.display=pools?'contents':'none';
  document.getElementById('crf-add-pool').style.display=pools?'':'none';
  document.getElementById('crf-routing-warn').style.display=pools?'':'none';
  document.querySelectorAll('.crfp-single-only').forEach(node=>node.hidden=pools);
  crfValidatePools(false);
}
function crfResetPoolDefaults(){
  CRF_POOL_CONFIG_KEYS.forEach(key=>{const field=document.getElementsByName(key)[0];if(field)field.value=CRF_POOL_DEFAULTS[key];});
  crfBuildPoolEditor(CRF_POOL_DEFAULTS.RUNNER_POOLS,CRF_POOL_DEFAULTS.POOL_AUTOSCALE);crfPoolMode();crfRefreshPoolPresentation();crfSetPoolDirty();
  crfToast('Pool defaults restored');
