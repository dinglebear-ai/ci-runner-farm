['RUNNER_CPUS','RUNNER_MEMORY','RESOURCE_CPU_BUDGET','RESOURCE_CPU_RESERVE','RESOURCE_CPU_OVERCOMMIT'].forEach(name=>{
  document.getElementsByName(name)[0].addEventListener('input',()=>{crfRefreshPoolPresentation();crfValidatePools(false);});
});
function crfPoolSnapshotData(){
  crfSerializePools();
  return Object.fromEntries(CRF_POOL_CONFIG_KEYS.map(key=>[key,String(document.getElementsByName(key)[0]?.value??'')]));
}
function crfPoolSnapshot(){return JSON.stringify(crfPoolSnapshotData());}
function crfPoolDiff(){
  const before=CRF_POOL_BASELINE?JSON.parse(CRF_POOL_BASELINE):{},after=crfPoolSnapshotData(),labels={
    RUNNER_POOLS:'Pool definitions and priority',POOL_AUTOSCALE:'Autoscaling pools',RUNNER_CPUS:'Default CPUs',RUNNER_MEMORY:'Default memory',
    EPHEMERAL:'Lifecycle',RUN_AS_ROOT:'Job user',RESOURCE_CPU_BUDGET:'CPU budget',RESOURCE_MEMORY_BUDGET:'Memory budget',
    RESOURCE_CPU_RESERVE:'Reserved CPU',RESOURCE_MEMORY_RESERVE:'Reserved memory',RESOURCE_CPU_OVERCOMMIT:'CPU overcommit',
    RESOURCE_MEMORY_SWAP:'Swap policy',RESOURCE_PIDS_LIMIT:'PID limit',AUTOSCALE_STEP:'Scale step',AUTOSCALE_INTERVAL:'Scale interval',
    AUTOSCALE_IDLE_GRACE:'Idle grace',RUNNER_MODE:'Layout',POOL_BACKEND:'Backend'
  };
  return Object.keys(after).filter(key=>String(before[key]??'')!==String(after[key]??'')).map(key=>({key,label:labels[key]||key,before:String(before[key]??''),after:String(after[key]??'')}));
}
function crfPersistPoolDraft(dirty){
  try{
    if(!dirty){sessionStorage.removeItem(CRF_POOL_DRAFT_KEY);return;}
    sessionStorage.setItem(CRF_POOL_DRAFT_KEY,JSON.stringify({config_revision:CRF_POOL_CONFIG_REVISION,settings:crfPoolSnapshotData()}));
  }catch(_error){}
}
function crfSetPoolDirty(){
  if(!CRF_POOL_BASELINE)return false;
  const dirty=crfPoolSnapshot()!==CRF_POOL_BASELINE,pill=document.getElementById('crfp-dirty-pill');
  pill.hidden=!dirty;crfPersistPoolDraft(dirty);return dirty;
}
function crfRestorePoolDraft(){
  let draft=null;try{draft=JSON.parse(sessionStorage.getItem(CRF_POOL_DRAFT_KEY)||'null');}catch(_error){}
  if(!draft||draft.config_revision!==CRF_POOL_CONFIG_REVISION||!draft.settings)return false;
  const settings=draft.settings;
  CRF_POOL_CONFIG_KEYS.forEach(key=>{if(key==='RUNNER_POOLS'||key==='POOL_AUTOSCALE')return;const field=document.getElementsByName(key)[0];if(field&&settings[key]!=null)field.value=String(settings[key]);});
  crfBuildPoolEditor(String(settings.RUNNER_POOLS||''),String(settings.POOL_AUTOSCALE??''));crfPoolMode();crfRefreshPoolPresentation();return true;
}
function crfOpenPoolReview(){
  if(!crfValidatePools(true))return;
  const changes=crfPoolDiff();if(!changes.length){crfToast('No changes to apply');return;}
  const lines=document.getElementById('crfp-review-lines');lines.replaceChildren(...changes.map(change=>{
    const row=document.createElement('div');row.className='crfp-review-line';
    const icon=document.createElement('i');icon.className='fa fa-pencil';icon.setAttribute('aria-hidden','true');
    const text=document.createElement('span'),before=document.createElement('code'),after=document.createElement('code');
    before.textContent=change.before||'(blank)';after.textContent=change.after||'(blank)';text.append(document.createTextNode(change.label+' from '),before,document.createTextNode(' to '),after);row.append(icon,text);return row;
  }));
  document.getElementById('crfp-review-backdrop').hidden=false;document.getElementById('crfp-confirm-apply').focus();
}
function crfClosePoolReview(){document.getElementById('crfp-review-backdrop').hidden=true;}

crfBuildPoolEditor(document.getElementById('crf-pools-value').value,CRF_POOL_AUTOSCALE_INITIAL);crfPoolMode();
CRF_POOL_BASELINE=crfPoolSnapshot();crfRestorePoolDraft();crfSetPoolDirty();
document.addEventListener('crf-pools-change',crfSetPoolDirty);
document.forms['ci_runner_pools'].addEventListener('input',crfSetPoolDirty);
document.forms['ci_runner_pools'].addEventListener('change',crfSetPoolDirty);
document.getElementById('crfp-review-backdrop').addEventListener('click',event=>{if(event.target===event.currentTarget)crfClosePoolReview();});
