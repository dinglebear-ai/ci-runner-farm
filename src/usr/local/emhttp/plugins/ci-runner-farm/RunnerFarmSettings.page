const CRFS_LABELS={
  AUTH_MODE:'Authentication',GITHUB_APP_ID:'GitHub App ID',GITHUB_APP_INSTALLATION_ID:'GitHub App installation ID',GH_SCOPE:'GitHub scope',GH_OWNER:'GitHub owner',GH_REPOS:'Target repositories',RUNNER_GROUP:'Runner group',
  CACHE_ROOT:'Cache root',WORK_TMPFS_SIZE:'Workspace tmpfs',CACHE_MOUNTS:'Cache mounts',DIND:'Docker-in-Docker',SHARE_DOCKER_SOCK:'Host docker.sock',SHARED_IMAGE_CACHE:'Shared image cache',NETWORK_ISOLATION:'Network isolation',DASHBOARD_WIDGET_ENABLE:'Main dashboard tile'
};
function crfsShowResult(message,ok){
  const result=document.getElementById('crfs-live-result');if(!result)return;
  result.textContent=message;result.classList.toggle('is-ok',!!ok);result.hidden=false;
  clearTimeout(CRFS_RESULT_TIMER);CRFS_RESULT_TIMER=setTimeout(()=>{result.hidden=true;},5000);
}
function crfsHiddenField(key){return document.forms['ci_runner_farm']?.elements.namedItem(key)||null;}
function crfsLiveField(key){return document.querySelector('[data-crfs-config="'+CSS.escape(key)+'"]');}
function crfsSyncFromConfig(keys=CRF_CONFIG_KEYS){
  for(const key of keys){
    const source=crfsHiddenField(key),target=crfsLiveField(key);
    if(source&&target)target.value=source.value;
  }
  const dashboard=crfsHiddenField('DASHBOARD_WIDGET_ENABLE');
  const sw=document.getElementById('crfs-dashboard-switch'),label=document.getElementById('crfs-dashboard-label');
  if(dashboard&&sw&&label){const on=dashboard.value==='true';sw.setAttribute('aria-checked',String(on));label.textContent=on?'shown on the main Dashboard':'hidden';}
  crfAuthMode();
}
function crfsCaptureApplied(){
  CRFS_APPLIED={};
  for(const key of CRF_CONFIG_KEYS){const el=crfsHiddenField(key);if(el)CRFS_APPLIED[key]=String(el.value);}
}
function crfsSetDirty(dirty,capture=false){
  if(capture)crfsCaptureApplied();
  const changes=Object.keys(CRFS_APPLIED).filter(key=>String(crfsHiddenField(key)?.value??'')!==String(CRFS_APPLIED[key]??''));
  dirty=!!dirty&&changes.length>0;
  const pill=document.getElementById('crfs-dirty-pill'),bar=document.getElementById('crfs-sticky-dirty');
  if(pill)pill.classList.toggle('is-visible',dirty);
  if(bar){bar.hidden=!dirty;const detail=bar.querySelector('.crfs-dirty-detail');if(detail)detail.textContent=changes.length+' setting(s) differ from the running config';}
  try{if(dirty)sessionStorage.setItem(CRFS_DRAFT_KEY,JSON.stringify({config_revision:CRF_CONFIG_REVISION,settings:Object.fromEntries(CRF_CONFIG_KEYS.map(key=>[key,String(crfsHiddenField(key)?.value??'')]))}));else sessionStorage.removeItem(CRFS_DRAFT_KEY);}catch(_error){}
  return dirty;
}
function crfsRestoreDraft(){
  let draft=null;try{draft=JSON.parse(sessionStorage.getItem(CRFS_DRAFT_KEY)||'null');}catch(_error){}
  if(!draft||draft.config_revision!==CRF_CONFIG_REVISION||!draft.settings)return false;
  for(const key of CRF_CONFIG_KEYS){if(draft.settings[key]==null)continue;const el=crfsHiddenField(key);if(el)el.value=String(draft.settings[key]);}
  crfsSyncFromConfig();return true;
}
function crfsResetGroup(keys){
  for(const key of keys){const el=crfsHiddenField(key);if(el&&Object.hasOwn(CRF_DEFAULTS,key))el.value=CRF_DEFAULTS[key];}
  crfsSyncFromConfig(keys);crfsSetDirty(true);
}
function crfsResetAll(){crfResetDefaults();crfsSetDirty(true);}
function crfsDiscardChanges(){
  for(const [key,value] of Object.entries(CRFS_APPLIED)){const el=crfsHiddenField(key);if(el)el.value=value;}
  crfsSyncFromConfig();crfsSetDirty(false);
}
function crfsToggleDashboard(){
  const value=crfsHiddenField('DASHBOARD_WIDGET_ENABLE');if(!value)return;
  value.value=value.value==='true'?'false':'true';crfsSyncFromConfig(['DASHBOARD_WIDGET_ENABLE']);crfsSetDirty(true);
}
function crfsSaveAppKey(){
  const live=document.getElementById('crfs-app-private-key-live'),legacy=document.getElementById('crf-app-private-key');
  if(!live||!legacy||!live.value.trim())return;legacy.value=live.value;crfSetAppKey();live.value='';
}
function crfsConfigDiff(){
  return Object.keys(CRFS_APPLIED).filter(key=>String(crfsHiddenField(key)?.value??'')!==String(CRFS_APPLIED[key]??'')).map(key=>({key,label:CRFS_LABELS[key]||key.toLowerCase().replaceAll('_',' '),before:String(CRFS_APPLIED[key]??''),after:String(crfsHiddenField(key)?.value??'')}));
}
function crfsReviewApply(){
  const changes=crfsConfigDiff();if(!changes.length){crfsShowResult('No changes to apply.',true);return;}
  const lines=document.getElementById('crfs-review-lines'),backdrop=document.getElementById('crfs-review-backdrop');if(!lines||!backdrop)return;
  lines.replaceChildren(...changes.map(change=>{const row=document.createElement('div');row.className='crfs-review-line';const icon=document.createElement('i');icon.className='fa fa-pencil';icon.setAttribute('aria-hidden','true');const text=document.createElement('span');text.append(document.createTextNode(change.label+' from '));const before=document.createElement('code'),after=document.createElement('code');before.textContent=change.before||'(blank)';after.textContent=change.after||'(blank)';text.append(before,document.createTextNode(' to '),after);row.append(icon,text);return row;}));
  backdrop.hidden=false;backdrop.querySelector('footer .crfs-gradient-button')?.focus();
}
function crfsCloseReview(){const backdrop=document.getElementById('crfs-review-backdrop');if(backdrop)backdrop.hidden=true;}
function crfsConfirmApply(){window.CRFS_APPLY_CONFIRMED=true;crfsCloseReview();document.forms['ci_runner_farm']?.requestSubmit();}
function crfsToggleDanger(button){
  const card=document.getElementById('crfs-danger-card'),open=button.getAttribute('aria-expanded')!=='true';
  button.setAttribute('aria-expanded',String(open));button.querySelector('span').textContent=open?'Hide danger zone':'Show danger zone';card.hidden=!open;if(!open)crfsCancelDanger();else crfsRefreshDangerImpact();
}
function crfsArmDanger(key){
  crfsCancelDanger();CRFS_DANGER_ARM=key;const row=document.querySelector('[data-crfs-danger="'+CSS.escape(key)+'"]');if(!row)return;row.querySelector('[data-crfs-danger-arm]').hidden=true;row.querySelector('[data-crfs-danger-confirm]').hidden=false;row.querySelector('input')?.focus();
}
function crfsCancelDanger(){
  CRFS_DANGER_ARM='';document.querySelectorAll('[data-crfs-danger]').forEach(row=>{const arm=row.querySelector('[data-crfs-danger-arm]'),confirm=row.querySelector('[data-crfs-danger-confirm]');if(arm)arm.hidden=false;if(confirm)confirm.hidden=true;});const typed=document.getElementById('crfs-uninstall-confirm');if(typed){typed.value='';typed.classList.remove('is-invalid');}crfsSyncUninstallConfirm();
}
function crfsSyncUninstallConfirm(){const typed=document.getElementById('crfs-uninstall-confirm'),button=document.getElementById('crfs-uninstall-button');if(!typed||!button)return;const ok=typed.value==='ci-runner-farm';button.disabled=!ok;typed.classList.toggle('is-invalid',typed.value.length>0&&!ok);}
function crfsDangerLast(key){try{return JSON.parse(localStorage.getItem('ci-runner-farm:danger-last')||'{}')[key]||'';}catch(_error){return '';}}
function crfsSetDangerLast(key){try{const all=JSON.parse(localStorage.getItem('ci-runner-farm:danger-last')||'{}');all[key]=new Date().toISOString();localStorage.setItem('ci-runner-farm:danger-last',JSON.stringify(all));}catch(_error){}crfsRenderDangerLast();}
function crfsRelativeAge(stamp){const age=Math.max(0,Date.now()-Date.parse(stamp));if(age<60000)return 'just now';if(age<3600000)return Math.floor(age/60000)+'m ago';if(age<86400000)return Math.floor(age/3600000)+'h ago';return Math.floor(age/86400000)+'d ago';}
function crfsBytes(bytes){if(!Number.isFinite(bytes)||bytes<0)return 'unavailable';const units=['B','KB','MB','GB','TB'];let value=bytes,index=0;while(value>=1024&&index<units.length-1){value/=1024;++index;}return (index===0?value:(value>=10?Math.round(value):value.toFixed(1)))+' '+units[index];}
function crfsRenderDangerLast(){document.querySelectorAll('[data-crfs-danger-last]').forEach(label=>{const stamp=crfsDangerLast(label.dataset.crfsDangerLast),time=Date.parse(stamp);label.textContent=Number.isFinite(time)?'last run '+crfsRelativeAge(stamp):'never run';});}
function crfsRefreshDangerImpact(){
  Promise.allSettled([crfPost({action:'status-json'}),crfPost({action:'cache-usage'})]).then(results=>{const status=results[0].status==='fulfilled'?results[0].value:null,cache=results[1].status==='fulfilled'?results[1].value:null;const runners=document.getElementById('crfs-danger-impact-dereg'),purge=document.getElementById('crfs-danger-impact-purge');if(runners&&status&&Number.isFinite(status.count))runners.textContent=status.count+' runner'+(status.count===1?'':'s');if(purge&&cache&&Number.isFinite(cache.pkg))purge.textContent=crfsBytes(cache.pkg)+' package caches';});
}
async function crfsConfirmDanger(key){
  if(CRFS_DANGER_ARM!==key)return;if(key==='uninstall'&&document.getElementById('crfs-uninstall-confirm')?.value!=='ci-runner-farm')return;
  const row=document.querySelector('[data-crfs-danger="'+CSS.escape(key)+'"]'),button=row?.querySelector('.is-confirm');if(button)button.disabled=true;
  if(key==='uninstall'){crfsSetDangerLast(key);location.assign('/Plugins');return;}
  const action=key==='dereg'?'stop':'cache-clear';
  try{const result=await crfPost({action});if(!result.ok)throw new Error(result.error||action+' failed');crfsSetDangerLast(key);crfToast(key==='dereg'?'Runners deregistered':'Package caches purged');crfsCancelDanger();crfsRefreshDangerImpact();}
  catch(err){crfToast(String(err&&err.message||err));if(button)button.disabled=false;}
}
(function crfsInitLiveSettings(){
  const slot=document.getElementById('crfs-token-slot'),band=document.getElementById('crf-tokband');
  if(slot&&band){slot.appendChild(band);const strong=band.querySelector('.crfs-tok-text strong');if(strong&&<?= $has_token ? 'true' : 'false' ?>){const code=document.createElement('code');code.textContent='ghp_••••'+<?=json_encode($token_hint)?>;strong.appendChild(code);const days=<?=json_encode($token_saved_age)?>;if(days!==null){const age=document.createElement('span');age.className='crfs-token-age';age.textContent='saved '+days+'d ago';strong.appendChild(age);}}}
  crfsSyncFromConfig();crfsCaptureApplied();const restored=crfsRestoreDraft();crfsSetDirty(restored);
  crfsRenderDangerLast();
  document.querySelectorAll('[data-crfs-config]').forEach(control=>{
    const sync=()=>{const hidden=crfsHiddenField(control.dataset.crfsConfig);if(!hidden)return;hidden.value=control.value;if(control.dataset.crfsConfig==='AUTH_MODE')crfAuthMode(true);crfsSetDirty(true);};
    control.addEventListener('input',sync);control.addEventListener('change',sync);
  });
})();
document.addEventListener('keydown',event=>{if(event.key==='Escape'){crfsCloseReview();crfsCancelDanger();}});
</script>
