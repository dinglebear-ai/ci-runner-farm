#!/usr/bin/env bash
set -euo pipefail
release="${CRF_CONTROLLER_RELEASE:-/opt/ci-runner-farm/current/controller/bin/crf_controller}"
[[ -x "$release" ]] || { echo "controller release executable not found: $release" >&2; exit 1; }

identifier() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$ ]]; }
generation() { [[ "$1" =~ ^[1-9][0-9]{0,18}$ ]]; }
inspect='|> IO.inspect(pretty: true, limit: :infinity, printable_limit: :infinity)'

case "${1:-status}" in
  status)
    [[ "$#" -le 1 ]] || { echo 'usage: crf-operator-status status' >&2; exit 64; }
    expression="CrfController.OperatorSnapshot.snapshot() $inspect"
    ;;
  drain|undrain)
    [[ "$#" -eq 3 ]] || { echo "usage: crf-operator-status $1 NODE_ID GENERATION" >&2; exit 64; }
    identifier "$2" && generation "$3" || { echo 'invalid node identity or generation' >&2; exit 64; }
    value=false; [[ "$1" = drain ]] && value=true
    expression="CrfController.OperatorActions.set_draining(\"$2\", $3, $value) $inspect"
    ;;
  force-abandon)
    [[ "$#" -eq 3 && "$3" = --force ]] || { echo 'usage: crf-operator-status force-abandon PLACEMENT_ID --force' >&2; exit 64; }
    identifier "$2" || { echo 'invalid placement identity' >&2; exit 64; }
    expression="CrfController.OperatorActions.force_abandon(\"$2\", true) $inspect"
    ;;
  *) echo 'usage: crf-operator-status {status|drain NODE_ID GENERATION|undrain NODE_ID GENERATION|force-abandon PLACEMENT_ID --force}' >&2; exit 64 ;;
esac

exec "$release" rpc "$expression"
