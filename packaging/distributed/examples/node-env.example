# Required node identity/controller transport.
CRF_NODE_ID=node-1
# Literal IPs are supported, but a Tailscale MagicDNS name avoids pinning a node to one address.
CRF_CONTROLLER_ADDR=controller.tailnet-name.ts.net:7443
CRF_CONTROLLER_SERVER_NAME=controller.tailnet-name.ts.net
CRF_CA_CERT=/etc/ci-runner-farm/tls/ca.pem
CRF_CLIENT_CERT=/etc/ci-runner-farm/tls/node.pem
CRF_CLIENT_KEY=/etc/ci-runner-farm/tls/node-key.pem

# Explicit host budget. The daemon refuses to advertise more than the host has.
CRF_NODE_CPU_MILLIS=8000
CRF_NODE_MEMORY_BYTES=17179869184

# Durable/private node state. This is shared by both execution backends.
CRF_STATE_DIR=/var/lib/ci-runner-farm/node/state
# Optional secret-free fleet projection for an authenticated local operator UI.
# Keep this on durable local storage; the node writes it atomically with mode 0600.
CRF_OPERATOR_PROJECTION_PATH=/var/lib/ci-runner-farm/node/status/controller.json

# Execution backend. Omit CRF_EXECUTION_BACKEND for the backward-compatible
# native_process default. Configure exactly one backend contract.
#
# Native process backend:
# CRF_EXECUTION_BACKEND=native_process
CRF_RUNTIME_DIR=/var/lib/ci-runner-farm/node/runners
CRF_LOG_DIR=/var/log/ci-runner-farm/node
# Choose exactly ONE native runner source.
# Managed pinned package (recommended):
CRF_RUNNER_MANIFEST=/etc/ci-runner-farm/runner-manifest.json
CRF_RUNNER_CACHE_DIR=/var/lib/ci-runner-farm/node/runner-cache
# Pre-staged template alternative:
# CRF_RUNNER_TEMPLATE=/opt/ci-runner-farm/runner-template
#
# Controller-approved container backend alternative:
# CRF_EXECUTION_BACKEND=container
# CRF_CONTAINER_ADAPTER_PROGRAM=/usr/local/libexec/ci-runner-farm/container-adapter
# CRF_CONTAINER_ADAPTER_TIMEOUT_MS=15000
# Native CRF_RUNTIME_DIR / CRF_LOG_DIR / runner-source settings are not required
# in container mode. The adapter receives the JIT descriptor only over stdin.

# Optional bounded tuning.
CRF_HEARTBEAT_MS=5000
CRF_CONNECT_TIMEOUT_MS=5000
CRF_IO_TIMEOUT_MS=15000
CRF_COMMAND_LEDGER_CAPACITY=4096
