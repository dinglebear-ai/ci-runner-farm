# Required node identity/controller transport.
CRF_NODE_ID=node-1
# Literal IPs are supported, but a Tailscale MagicDNS name avoids pinning a node to one address.
CRF_CONTROLLER_ADDR=controller.tailnet-name.ts.net:7443
CRF_CONTROLLER_SERVER_NAME=controller.tailnet-name.ts.net
CRF_CA_CERT=/etc/ci-runner-farm/tls/ca.pem
CRF_CLIENT_CERT=/etc/ci-runner-farm/tls/node.pem
CRF_CLIENT_KEY=/etc/ci-runner-farm/tls/node-key.pem

# Host-aware budget. `auto` subtracts these operator reserves from live logical
# CPU and RAM before advertising capacity. Use explicit positive quantities on
# shared hosts (for example Windows plus WSL) so the same hardware is not
# double-counted until both runtimes share one capacity domain.
CRF_NODE_CPU_MILLIS=auto
CRF_NODE_MEMORY_BYTES=auto
CRF_NODE_CPU_RESERVE_MILLIS=2000
CRF_NODE_MEMORY_RESERVE_BYTES=4294967296

# Durable/private node state. This is shared by both execution backends.
CRF_STATE_DIR=/var/lib/ci-runner-farm/node/state
# Optional secret-free fleet projection for an authenticated local operator UI.
# Keep this on durable local storage; the node writes it atomically with mode 0600.
CRF_OPERATOR_PROJECTION_PATH=/var/lib/ci-runner-farm/node/status/controller.json

# A backend is mandatory. Native processes are rejected because repository code
# would share the node agent identity and could read its mTLS/control state.
# Install a compatible isolated adapter before enabling the node service.
CRF_EXECUTION_BACKEND=container
CRF_CONTAINER_ADAPTER_PROGRAM=/opt/ci-runner-farm/current/bin/crf-container-adapter
CRF_CONTAINER_ADAPTER_TIMEOUT_MS=60000
# The adapter receives the JIT descriptor only over bounded stdin.

# Portable Linux Docker adapter. The image must be immutable and contain the
# GitHub Actions runner plus jq, base64, gosu, and a non-root runner account.
# Build with `docker build -f deployments/distributed/runner.Dockerfile deployments/distributed`, publish it to the first-party
# registry, then replace the marker with the verified manifest digest. A tag or
# a digest from the generic upstream runner image is not an accepted substitute.
CRF_RUNNER_IMAGE=ghcr.io/dinglebear-ai/ci-runner-farm-distributed@sha256:<published-image-digest>
CRF_CONTAINER_STATE_DIR=/var/lib/ci-runner-farm/container-adapter
CRF_CONTAINER_WORK_ROOT=/var/lib/ci-runner-farm/work

# Optional bounded tuning.
CRF_HEARTBEAT_MS=5000
CRF_CONNECT_TIMEOUT_MS=5000
CRF_IO_TIMEOUT_MS=15000
CRF_COMMAND_LEDGER_CAPACITY=4096
