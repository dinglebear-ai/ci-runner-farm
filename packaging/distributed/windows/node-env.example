# Copy to C:\ProgramData\CiRunnerFarm\node.env and replace every example value.
CRF_NODE_ID=windows-node-1
CRF_CONTROLLER_ADDR=controller.tailnet-name.ts.net:7443
CRF_CONTROLLER_SERVER_NAME=controller.tailnet-name.ts.net
CRF_CA_CERT=C:\ProgramData\CiRunnerFarm\tls\ca.pem
CRF_CLIENT_CERT=C:\ProgramData\CiRunnerFarm\tls\node.pem
CRF_CLIENT_KEY=C:\ProgramData\CiRunnerFarm\tls\node-key.pem
CRF_NODE_CPU_MILLIS=8000
CRF_NODE_MEMORY_BYTES=17179869184
CRF_STATE_DIR=C:\ProgramData\CiRunnerFarm\state
CRF_SERVICE_ERROR_LOG=C:\ProgramData\CiRunnerFarm\logs\service-errors.log
# Windows jobs run in one fresh Hyper-V-isolated Windows container per placement.
CRF_EXECUTION_BACKEND=container
CRF_CONTAINER_ADAPTER_PROGRAM=sibling
CRF_CONTAINER_ADAPTER_TIMEOUT_MS=15000
CRF_CONTAINER_STATE_DIR=C:\ProgramData\CiRunnerFarm\container-adapter
# Pin a prepared Windows runner image by digest; tags are rejected.
CRF_RUNNER_IMAGE=example.invalid/windows-runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
